@model Clinexa.Models.Entities.User

@{
    ViewData["Title"] = "User Details";
}

@section PageActions {

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary px-3 py-2">

        <i class="bi bi-pencil me-1"></i>
        Edit User

    </a>

    <a asp-action="SetPassword"
       asp-route-id="@Model.Id"
       class="btn btn-warning px-3 py-2">

        <i class="bi bi-key me-1"></i>
        Set Password

    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary px-3 py-2">

        <i class="bi bi-arrow-left me-1"></i>
        Back

    </a>
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">User Information</h3>
    </div>

    <div class="card-body">

        <div class="row g-4">

            <!-- Full Name -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Full Name
                </div>

                <div class="fw-semibold fs-3">
                    @Model.FirstName @Model.LastName
                </div>

            </div>


            <!-- User ID -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    User ID
                </div>

                <div class="fw-semibold">
                    #@Model.Id
                </div>

            </div>


            <!-- Email -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Email
                </div>

                <div>
                    @Model.Email
                </div>

            </div>


            <!-- Phone -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Phone Number
                </div>

                <div>
                    @Model.PhoneNumber
                </div>

            </div>


            <!-- Role -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Role
                </div>

                <div>
                    <span class="badge bg-blue-lt">
                        @(ViewBag.RoleName ?? "No Role")
                    </span>
                </div>

            </div>


            <!-- Status -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Status
                </div>

                <div>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-green-lt">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-lt">
                            Inactive
                        </span>
                    }

                </div>

            </div>


            <!-- Created At -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Created At
                </div>

                <div>
                    @Model.CreatedAt
                </div>

            </div>


            <!-- Last Login -->
            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Last Login
                </div>

                <div>
                    @(Model.LastLoginAt.HasValue? Model.LastLoginAt.Value : "Never")
                </div>

            </div>

        </div>

    </div>

</div>