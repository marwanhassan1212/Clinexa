@model Clinexa.Models.Entities.User

@{
    ViewData["Title"] = "User Details";
}

@section PageActions {

    <a asp-action="Edit"
       asp-route-id="@Model.UserId"
       class="btn btn-primary px-3 py-2">

        <i class="bi bi-pencil me-1"></i>
        Edit User

    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary px-3 py-2">

        <i class="bi bi-arrow-left me-1"></i>
        Back

    </a>
}

<div class="card">

    <div class="card-header">
        <h3 class="card-title">User Information</h3>
    </div>

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Full Name
                </div>

                <div class="fw-semibold fs-3">
                    @Model.FirstName @Model.LastName
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    User ID
                </div>

                <div class="fw-semibold">
                    #@Model.UserId
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Email
                </div>

                <div>
                    @Model.Email
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Phone Number
                </div>

                <div>
                    @Model.PhoneNumber
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Role
                </div>

                <div>
                    <span class="badge bg-blue-lt">
                        @Model.Role?.Name
                    </span>
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Status
                </div>

                <div>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-green-lt">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-lt">
                            Inactive
                        </span>
                    }

                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Created At
                </div>

                <div>
                    @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                </div>

            </div>

            <div class="col-md-6">

                <div class="text-secondary mb-1">
                    Last Login
                </div>

                <div>

                    @(Model.LastLoginAt.HasValue
                                        ? Model.LastLoginAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        : "Never")

                </div>

            </div>

        </div>

    </div>

</div>