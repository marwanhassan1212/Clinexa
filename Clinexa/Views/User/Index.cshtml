@model Clinexa.Models.ViewModels.User.UserFilterViewModel

@{
    ViewData["Title"] = "Users";
}

@section PageActions {
    <a asp-action="Create"
       class="btn btn-primary px-3 py-2">

        <i class="bi bi-plus-lg me-1"></i>
        Add User

    </a>
}

<div class="card">

    <!-- Header -->
    <div class="card-header">

        <h3 class="card-title">
            System Users
        </h3>

        <div class="card-actions">

            <span class="text-secondary">
                @Model.TotalCount user(s)
            </span>

        </div>

    </div>


    <!-- Filters -->
    <div class="card-body border-bottom">

        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- Search -->
                <div class="col-md-5">

                    <label asp-for="Search"
                           class="form-label">

                        Search

                    </label>

                    <input asp-for="Search"
                           class="form-control"
                           placeholder="Name, email or phone..." />

                </div>


                <!-- Role -->
                <div class="col-md-3">

                    <label asp-for="RoleId"
                           class="form-label">

                        Role

                    </label>

                    <select asp-for="RoleId"
                            class="form-select">

                        <option value="">
                            All Roles
                        </option>

                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.RoleId">
                                @role.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Status -->
                <div class="col-md-2">

                    <label asp-for="IsActive"
                           class="form-label">

                        Status

                    </label>

                    <select asp-for="IsActive"
                            class="form-select">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- Filter Actions -->
                <div class="col-md-2">

                    <div class="d-flex gap-2">

                        <!-- Reset -->
                        <a asp-action="Index"
                           class="btn btn-outline-secondary flex-fill"
                           title="Reset">

                            <i class="bi bi-arrow-counterclockwise"></i>

                        </a>


                        <!-- Apply -->
                        <button type="submit"
                                class="btn btn-primary flex-fill"
                                title="Apply Filters">

                            <i class="bi bi-search"></i>

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>


    <!-- Users Table -->
    <div class="table-responsive">

        <table class="table table-vcenter card-table">

            <thead>

                <tr>

                    <th>
                        User
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Phone
                    </th>

                    <th>
                        Role
                    </th>

                    <th>
                        Status
                    </th>

                    <th class="w-1 text-end">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Users.Any())
                {
                    foreach (var user in Model.Users)
                    {
                        <tr>

                            <!-- User -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <span class="avatar avatar-sm bg-blue-lt me-2">

                                        <i class="bi bi-person"></i>

                                    </span>

                                    <div>

                                        <div class="fw-semibold">

                                            @user.FirstName @user.LastName

                                        </div>

                                        <div class="text-secondary small">

                                            #@user.UserId

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- Email -->
                            <td>

                                <span class="text-secondary">

                                    @user.Email

                                </span>

                            </td>


                            <!-- Phone -->
                            <td>

                                @user.PhoneNumber

                            </td>


                            <!-- Role -->
                            <td>

                                <span class="badge bg-blue-lt">

                                    @user.Role?.Name

                                </span>

                            </td>


                            <!-- Status -->
                            <td>

                                @if (user.IsActive)
                                {
                                    <span class="badge bg-green-lt">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-red-lt">Inactive</span>
                                }

                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="btn-list flex-nowrap justify-content-end">

                                    <!-- Details -->
                                    <a asp-action="Details"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <!-- Edit -->
                                    <a asp-action="Edit"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    @if (user.IsActive)
                                    {
                                        <!-- Deactivate -->
                                        <form asp-action="Deactivate"
                                              asp-route-id="@user.UserId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Deactivate"
                                                    onclick="return confirm('Are you sure you want to deactivate this user?');">

                                                <i class="bi bi-person-x"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <!-- Activate -->
                                        <form asp-action="Activate"
                                              asp-route-id="@user.UserId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activate">

                                                <i class="bi bi-person-check"></i>

                                            </button>

                                        </form>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <!-- Empty State -->
                    <tr>

                        <td colspan="6">

                            <div class="clinexa-empty-state">

                                <div class="clinexa-empty-state-icon">

                                    <i class="bi bi-people"></i>

                                </div>

                                <div class="clinexa-empty-state-title">

                                    No users found

                                </div>

                                <div class="clinexa-empty-state-text">

                                    There are no users matching your current search.

                                </div>

                                <div>

                                    <a asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-1"></i>

                                        Add User

                                    </a>

                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer">

            <div class="d-flex justify-content-center">

                <ul class="pagination mb-0">

                    <!-- Previous -->
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Search="@Model.Search"
                           asp-route-RoleId="@Model.RoleId"
                           asp-route-IsActive="@Model.IsActive"
                           asp-route-Page="@(Model.Page - 1)">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>


                    <!-- Page Numbers -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Search="@Model.Search"
                               asp-route-RoleId="@Model.RoleId"
                               asp-route-IsActive="@Model.IsActive"
                               asp-route-Page="@i">

                                @i

                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Search="@Model.Search"
                           asp-route-RoleId="@Model.RoleId"
                           asp-route-IsActive="@Model.IsActive"
                           asp-route-Page="@(Model.Page + 1)">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </div>

        </div>
    }

</div>