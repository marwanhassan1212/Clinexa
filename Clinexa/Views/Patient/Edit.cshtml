@model Clinexa.Models.ViewModels.Patient.EditViewModel

@{
    ViewData["Title"] = "Edit Patient";
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        ```
        <div class="card clinexa-card">

            <div class="card-header">
                <div>
                    <h3 class="card-title mb-1">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>
                        Edit Patient
                    </h3>

                    <div class="text-secondary">
                        Update patient information
                    </div>
                </div>
            </div>

            <div class="card-body">

                <form asp-controller="Patient"
                      asp-action="Edit"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="PatientId" type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>


                    <!-- Patient Information -->
                    <div class="mb-4">

                        <h4 class="mb-1">
                            Patient Information
                        </h4>

                        <div class="text-secondary mb-3">
                            Update the patient's basic information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="FirstName"
                                       class="form-label">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control"
                                       placeholder="Enter first name" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="LastName"
                                       class="form-label">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control"
                                       placeholder="Enter last name" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-4">
                                <label asp-for="DateOfBirth"
                                       class="form-label">
                                    Date of Birth
                                </label>

                                <input asp-for="DateOfBirth"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="DateOfBirth"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-4">
                                <label asp-for="Gender"
                                       class="form-label">
                                    Gender
                                </label>

                                <select asp-for="Gender"
                                        class="form-select">

                                    <option value="">
                                        Select gender
                                    </option>

                                    <option value="Male">
                                        Male
                                    </option>

                                    <option value="Female">
                                        Female
                                    </option>

                                </select>

                                <span asp-validation-for="Gender"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-4">
                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="Email"
                                       class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="patient@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="Address"
                                       class="form-label">
                                    Address
                                </label>

                                <input asp-for="Address"
                                       class="form-control"
                                       placeholder="Enter address" />

                                <span asp-validation-for="Address"
                                      class="text-danger"></span>
                            </div>

                        </div>
                    </div>


                    <hr class="my-4" />


                    <!-- Emergency Contact -->
                    <div class="mb-4">

                        <h4 class="mb-1">
                            Emergency Contact
                        </h4>

                        <div class="text-secondary mb-3">
                            Update emergency contact information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label asp-for="EmergencyContactName"
                                       class="form-label">
                                    Contact Name
                                </label>

                                <input asp-for="EmergencyContactName"
                                       class="form-control"
                                       placeholder="Enter contact name" />

                                <span asp-validation-for="EmergencyContactName"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-6">
                                <label asp-for="EmergencyContactPhone"
                                       class="form-label">
                                    Contact Phone
                                </label>

                                <input asp-for="EmergencyContactPhone"
                                       class="form-control"
                                       placeholder="Enter contact phone" />

                                <span asp-validation-for="EmergencyContactPhone"
                                      class="text-danger"></span>
                            </div>

                        </div>
                    </div>


                    <hr class="my-4" />


                    <!-- Medical Information -->
                    <div>

                        <h4 class="mb-1">
                            Medical Information
                        </h4>

                        <div class="text-secondary mb-3">
                            Update additional medical information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label asp-for="BloodType"
                                       class="form-label">
                                    Blood Type
                                </label>

                                <select asp-for="BloodType"
                                        class="form-select">

                                    <option value="">
                                        Select blood type
                                    </option>

                                    <option value="A+">A+</option>
                                    <option value="A-">A-</option>
                                    <option value="B+">B+</option>
                                    <option value="B-">B-</option>
                                    <option value="AB+">AB+</option>
                                    <option value="AB-">AB-</option>
                                    <option value="O+">O+</option>
                                    <option value="O-">O-</option>

                                </select>

                                <span asp-validation-for="BloodType"
                                      class="text-danger"></span>
                            </div>


                            <div class="col-md-8">
                                <label asp-for="Allergies"
                                       class="form-label">
                                    Allergies
                                </label>

                                <textarea asp-for="Allergies"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter known allergies, if any"></textarea>

                                <span asp-validation-for="Allergies"
                                      class="text-danger"></span>
                            </div>

                        </div>
                    </div>


                    <!-- Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                        <a asp-controller="Patient"
                           asp-action="Details"
                           asp-route-id="@Model.PatientId"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Cancel

                        </a>


                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-check-lg me-1"></i>
                            Save Changes

                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
    ```

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
