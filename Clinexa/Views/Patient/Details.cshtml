@model Clinexa.Models.Entities.Patient

@{
    ViewData["Title"] = "Patient Details";
}

<div class="row justify-content-center">
    <div class="col-xl-10">

        ```
        <!-- Patient Header -->
        <div class="card clinexa-card mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <div class="d-flex align-items-center gap-3">

                        <div class="clinexa-patient-avatar bg-primary-lt text-primary"
                             style="width: 56px; height: 56px; font-size: 1.25rem;">
                            @Model.FirstName.Substring(0, 1).ToUpper()
                            @Model.LastName.Substring(0, 1).ToUpper()
                        </div>

                        <div>
                            <h2 class="mb-1">
                                @Model.FirstName @Model.LastName
                            </h2>

                            <div class="text-secondary">
                                Patient ID: #@Model.PatientId
                            </div>
                        </div>

                    </div>

                    <div class="d-flex align-items-center gap-2">

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Active
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-lt text-danger">
                                <i class="bi bi-x-circle me-1"></i>
                                Inactive
                            </span>
                        }

                      

                    </div>

                </div>
            </div>
        </div>


        <div class="row g-3">

            <!-- Personal Information -->
            <div class="col-lg-6">

                <div class="card clinexa-card h-100">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title mb-1">
                                <i class="bi bi-person me-2 text-primary"></i>
                                Personal Information
                            </h3>

                            <div class="text-secondary">
                                Basic patient information
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-sm-6">
                                <div class="text-secondary small mb-1">
                                    First Name
                                </div>

                                <div class="fw-semibold">
                                    @Model.FirstName
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="text-secondary small mb-1">
                                    Last Name
                                </div>

                                <div class="fw-semibold">
                                    @Model.LastName
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="text-secondary small mb-1">
                                    Date of Birth
                                </div>

                                <div class="fw-semibold">
                                    @Model.DateOfBirth.ToString("dd MMM yyyy")
                                </div>
                            </div>

                            <div class="col-sm-6">
                                <div class="text-secondary small mb-1">
                                    Gender
                                </div>

                                <div class="fw-semibold">
                                    @Model.Gender
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Address
                                </div>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Address)
                                                                        ? "Not provided"
                                                                        : Model.Address)
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <!-- Contact Information -->
            <div class="col-lg-6">

                <div class="card clinexa-card h-100">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title mb-1">
                                <i class="bi bi-telephone me-2 text-primary"></i>
                                Contact Information
                            </h3>

                            <div class="text-secondary">
                                Patient contact details
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Phone Number
                                </div>

                                <div class="fw-semibold">
                                    @Model.PhoneNumber
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Email
                                </div>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.Email)
                                                                        ? "Not provided"
                                                                        : Model.Email)
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Emergency Contact
                                </div>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.EmergencyContactName)
                                                                        ? "Not provided"
                                                                        : Model.EmergencyContactName)
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Emergency Phone
                                </div>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone)
                                                                        ? "Not provided"
                                                                        : Model.EmergencyContactPhone)
                                </div>
                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <!-- Medical Information -->
            <div class="col-lg-6">

                <div class="card clinexa-card h-100">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title mb-1">
                                <i class="bi bi-heart-pulse me-2 text-danger"></i>
                                Medical Information
                            </h3>

                            <div class="text-secondary">
                                Important medical information
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-sm-6">
                                <div class="text-secondary small mb-1">
                                    Blood Type
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.BloodType))
                                {
                                    <span class="badge bg-red-lt text-red">
                                        @Model.BloodType
                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        Not provided
                                    </span>
                                }
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Allergies
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Allergies))
                                {
                                    <div class="p-3 bg-red-lt rounded">
                                        @Model.Allergies
                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        No known allergies recorded
                                    </span>
                                }
                            </div>

                        </div>

                    </div>
                </div>

            </div>


            <!-- System Information -->
            <div class="col-lg-6">

                <div class="card clinexa-card h-100">

                    <div class="card-header">
                        <div>
                            <h3 class="card-title mb-1">
                                <i class="bi bi-info-circle me-2 text-primary"></i>
                                Record Information
                            </h3>

                            <div class="text-secondary">
                                Patient record details
                            </div>
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Patient ID
                                </div>

                                <div class="fw-semibold">
                                    #@Model.PatientId
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Registered On
                                </div>

                                <div class="fw-semibold">
                                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="text-secondary small mb-1">
                                    Status
                                </div>

                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success-lt text-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-lt text-danger">
                                        Inactive
                                    </span>
                                }
                            </div>

                        </div>

                    </div>
                </div>

            </div>

        </div>


        <!-- Bottom Actions -->
        <div class="d-flex justify-content-between align-items-center mt-3">

            <a asp-controller="Patient"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back to Patients
            </a>

            <a asp-controller="Patient"
               asp-action="Edit"
               asp-route-id="@Model.PatientId"
               class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>
                Edit Patient
            </a>

        </div>

    </div>
    ```

</div>
