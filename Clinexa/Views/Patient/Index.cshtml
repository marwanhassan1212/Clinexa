@model Clinexa.Models.ViewModels.Patient.PatientFilterViewModel

@{
    ViewData["Title"] = "Patients";
}

@section PageActions {
    <a asp-controller="Patient"
       asp-action="Create"
       class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-lg me-1"></i>
        Add Patient
    </a>
}

<div class="card clinexa-card" style="position: relative; top: -11px;">

    <!-- Header -->
    <div class="card-header py-2">
        <div class="row w-100 align-items-center">

            <div class="col">
                <h3 class="card-title mb-1">
                    Patients
                </h3>

                <div class="text-secondary">
                    Manage and view registered patients
                </div>
            </div>

            <div class="col-auto">
                <span class="badge bg-blue-lt">
                    @Model.Patients.Count patients
                </span>
            </div>

        </div>
    </div>


    <!-- Search -->
    <div class="card-body border-bottom clinexa-patient-filters">

        <form asp-controller="Patient"
              asp-action="Index"
              method="get">

            <div class="row g-2">

                <!-- Search -->
                <div class="col-md-4">

                    <div class="input-icon">

                        <span class="input-icon-addon">
                            <i class="bi bi-search"></i>
                        </span>

                       <input type="text"
                               name="Search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Search by name, phone or email..." />

                    </div>

                </div>
           


                <!-- Gender -->
                <div class="col-md-2">

                    <select name="Gender" class="form-select">

                        <option value="">Gender</option>

                        <option value="Male"
                                selected="@(Model.Gender?.ToString() == "Male")">
                            Male
                        </option>

                        <option value="Female"
                                selected="@(Model.Gender?.ToString() == "Female")">
                            Female
                        </option>

                    </select>

                </div>

                <!-- Blood Type -->
                <div class="col-md-2">

                    <select asp-for="BloodType"
                            class="form-select">

                        <option value="">Blood Type</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>

                    </select>

                </div>

                <!-- Status -->
                <div class="col-md-2">

                    <select asp-for="IsActive"
                            class="form-select">

                        <option value="">Status</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>

                    </select>

                </div>

                <!-- Search Button -->
                <div class="col-md-1">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                    </button>

                </div>

                <!-- Reset Button -->
                <div class="col-md-1">

                    <a asp-controller="Patient"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>

                    </div>

                </div>


        </form>

    </div>


    <!-- Table -->
    <div class="table-responsive clinexa-patient-table">

        @if (Model.Patients.Any())
        {
            <table class="table table-vcenter card-table clinexa-table">

                <thead>

                    <tr>
                        <th>Patient</th>
                        <th>Phone</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var patient in Model.Patients)
                    {
                        <tr>

                            <!-- Patient -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <span class="avatar avatar-sm bg-blue-lt me-2">
                                        @patient.FirstName.Substring(0, 1)
                                    </span>

                                    <div>

                                        <div class="clinexa-patient-name">
                                            @patient.FirstName @patient.LastName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(patient.Email))
                                        {
                                            <div class="clinexa-patient-meta">
                                                @patient.Email
                                            </div>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- Phone -->
                            <td>
                                @patient.PhoneNumber
                            </td>


                            <!-- Gender -->
                            <td>
                                @patient.Gender
                            </td>


                            <!-- Date of Birth -->
                            <td>
                                @patient.DateOfBirth.ToString("dd MMM yyyy")
                            </td>


                            <!-- Status -->
                            <td>

                                @if (patient.IsActive)
                                {
                                    <span class="clinexa-status clinexa-status-success">
                                        <span class="clinexa-status-dot"></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="clinexa-status clinexa-status-danger">
                                        <span class="clinexa-status-dot"></span>
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- Actions -->
                            <td>
                                <div class="btn-list flex-nowrap" style="margin-left: 20px;">

                                    <a asp-controller="Patient"
                                       asp-action="Details"
                                       asp-route-id="@patient.PatientId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-controller="Patient"
                                       asp-action="Edit"
                                       asp-route-id="@patient.PatientId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (patient.IsActive)
                                    {
                                        <form asp-controller="Patient"
                                              asp-action="Deactivate"
                                              asp-route-id="@patient.PatientId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Deactivate"
                                                    onclick="return confirm('Are you sure you want to deactivate this patient?');">

                                                <i class="bi bi-person-x"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Patient"
                                              asp-action="Activate"
                                              asp-route-id="@patient.PatientId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activate">

                                                <i class="bi bi-person-check"></i>

                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>



            </table>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 border-top">

                    <ul class="pagination mb-0">

                        <!-- Previous -->
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Patient"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-Gender="@Model.Gender"
                                   asp-route-BloodType="@Model.BloodType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@(Model.Page - 1)"
                                   asp-route-PageSize="@Model.PageSize">

                                    <i class="bi bi-chevron-left"></i>

                                </a>
                            </li>
                        }

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="Patient"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-Gender="@Model.Gender"
                                   asp-route-BloodType="@Model.BloodType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@i"
                                   asp-route-PageSize="@Model.PageSize">

                                    @i

                                </a>

                            </li>
                        }

                        <!-- Next -->
                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   asp-controller="Patient"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-Gender="@Model.Gender"
                                   asp-route-BloodType="@Model.BloodType"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@(Model.Page + 1)"
                                   asp-route-PageSize="@Model.PageSize">

                                    <i class="bi bi-chevron-right"></i>

                                </a>
                            </li>
                        }

                    </ul>

                </div>
            }

        }
        else
        {
            <!-- Empty State -->

            <div class="clinexa-empty-state">

                <div class="clinexa-empty-state-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div class="clinexa-empty-state-title">
                    No patients found
                </div>

                <div class="clinexa-empty-state-text">
                    There are no patients matching your current search.
                </div>

                <a asp-controller="Patient"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Add Patient

                </a>

            </div>
        }

    </div>



</div>


@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success('@TempData["Success"]');
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            toastr.success('@TempData["SuccessMessage"]');
        </script>
    }

}