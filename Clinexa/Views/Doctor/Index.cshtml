
@model Clinexa.Models.ViewModels.Doctor.DoctorFilterViewModel

@{
    ViewData["Title"] = "Doctors";
}

@section PageActions {
    <a asp-controller="Doctor"
       asp-action="Create"
       class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-lg me-1"></i>
        Add Doctor
    </a>
}

<div class="card clinexa-card" style="position: relative; top: -11px;">

    <!-- Header -->
    <div class="card-header py-2">

        <div class="row w-100 align-items-center">

            <div class="col">

                <h3 class="card-title mb-1">
                    Doctors
                </h3>

                <div class="text-secondary">
                    Manage and view registered doctors
                </div>

            </div>

            <div class="col-auto">

                <span class="badge bg-blue-lt">
                    @Model.Doctors.Count doctors
                </span>

            </div>

        </div>

    </div>


    <!-- Search & Filters -->
    <div class="card-body border-bottom clinexa-patient-filters">

        <form asp-controller="Doctor"
              asp-action="Index"
              method="get">

            <div class="row g-2">

                <!-- Search -->
                <div class="col-md-5">

                    <div class="input-icon">

                        <span class="input-icon-addon">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="Search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Search by name, phone or email..." />

                    </div>

                </div>


                <!-- Speciality -->
                <div class="col-md-3">

                    <select name="SpecialityId"
                            class="form-select">

                        <option value="">
                            Speciality
                        </option>

                        @foreach (var speciality in Model.Specialities)
                        {
                            <option value="@speciality.SpecialityId"
                                    selected="@(Model.SpecialityId == speciality.SpecialityId)">
                                @speciality.Name
                            </option>
                        }

                    </select>

                </div>


                <!-- Status -->
                <div class="col-md-2">

                    <select name="IsActive"
                            class="form-select">

                        <option value="">
                            Status
                        </option>

                        <option value="true"
                                selected="@(Model.IsActive == true)">
                            Active
                        </option>

                        <option value="false"
                                selected="@(Model.IsActive == false)">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- Search Button -->
                <div class="col-md-1">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="bi bi-search"></i>

                    </button>

                </div>


                <!-- Reset Button -->
                <div class="col-md-1">

                    <a asp-controller="Doctor"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100">

                        <i class="bi bi-arrow-counterclockwise"></i>

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- Table -->
    <div class="table-responsive clinexa-patient-table">

        @if (Model.Doctors.Any())
        {
            <table class="table table-vcenter card-table clinexa-table">

                <thead>

                    <tr>

                        <th>Doctor</th>

                        <th>Speciality</th>

                        <th>Phone</th>

                        <th>Consultation Fee</th>

                        <th>Status</th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var doctor in Model.Doctors)
                    {
                        <tr>

                            <!-- Doctor -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <span class="avatar avatar-sm bg-blue-lt me-2">

                                        @doctor.User.FirstName.Substring(0, 1)

                                    </span>

                                    <div>

                                        <div class="clinexa-patient-name">

                                            Dr. @doctor.User.FirstName
                                            @doctor.User.LastName

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(doctor.User.Email))
                                        {
                                            <div class="clinexa-patient-meta">

                                                @doctor.User.Email

                                            </div>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- Speciality -->
                            <td>

                                @doctor.Speciality.Name

                            </td>


                            <!-- Phone -->
                            <td>

                                @doctor.User.PhoneNumber

                            </td>


                            <!-- Consultation Fee -->
                            <td>

                                @doctor.ConsultationFee.ToString("N2") EGP

                            </td>


                            <!-- Status -->
                            <td>

                                @if (doctor.IsActive)
                                {
                                    <span class="clinexa-status clinexa-status-success">

                                        <span class="clinexa-status-dot"></span>

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="clinexa-status clinexa-status-danger">

                                        <span class="clinexa-status-dot"></span>

                                        Inactive

                                    </span>
                                }

                            </td>


                            <!-- Actions -->
                            <td>
                                <div class="btn-list flex-nowrap">

                                    <a asp-controller="Doctor"
                                       asp-action="Details"
                                       asp-route-id="@doctor.DoctorId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-controller="Doctor"
                                       asp-action="Edit"
                                       asp-route-id="@doctor.DoctorId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    @if (doctor.IsActive)
                                    {
                                        <form asp-controller="Doctor"
                                              asp-action="Deactivate"
                                              asp-route-id="@doctor.DoctorId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Deactivate"
                                                    onclick="return confirm('Are you sure you want to deactivate this doctor?');">

                                                <i class="bi bi-person-x"></i>

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Doctor"
                                              asp-action="Activate"
                                              asp-route-id="@doctor.DoctorId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activate">

                                                <i class="bi bi-person-check"></i>

                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center py-3 border-top">

                    <ul class="pagination mb-0">

                        <!-- Previous -->
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   asp-controller="Doctor"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-SpecialityId="@Model.SpecialityId"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@(Model.Page - 1)"
                                   asp-route-PageSize="@Model.PageSize">

                                    <i class="bi bi-chevron-left"></i>

                                </a>

                            </li>
                        }


                        <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">

                                <a class="page-link"
                                   asp-controller="Doctor"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-SpecialityId="@Model.SpecialityId"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@i"
                                   asp-route-PageSize="@Model.PageSize">

                                    @i

                                </a>

                            </li>
                        }


                        <!-- Next -->
                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">

                                <a class="page-link"
                                   asp-controller="Doctor"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-SpecialityId="@Model.SpecialityId"
                                   asp-route-IsActive="@Model.IsActive"
                                   asp-route-Page="@(Model.Page + 1)"
                                   asp-route-PageSize="@Model.PageSize">

                                    <i class="bi bi-chevron-right"></i>

                                </a>

                            </li>
                        }

                    </ul>

                </div>
            }

        }
        else
        {
            <!-- Empty State -->

            <div class="clinexa-empty-state">

                <div class="clinexa-empty-state-icon">

                    <i class="bi bi-person-badge"></i>

                </div>

                <div class="clinexa-empty-state-title">

                    No doctors found

                </div>

                <div class="clinexa-empty-state-text">

                    There are no doctors matching your current search.

                </div>

                <a asp-controller="Doctor"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>

                    Add Doctor

                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            toastr.success('@TempData["Success"]');
        </script>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            toastr.success('@TempData["SuccessMessage"]');
        </script>
    }

}
```
