@model Clinexa.Models.ViewModels.Prescription.PrescriptionCreateViewModel

@{
    ViewData["Title"] = "Create Prescription";
}

@section PageActions {

    <a asp-controller="MedicalRecord"
       asp-action="Details"
       asp-route-id="@Model.MedicalRecordId"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Medical Record

    </a>

}

<div class="row justify-content-center">

    <div class="col-lg-8 col-xl-7">

        <div class="card">

            <!-- Header -->
            <div class="card-header">

                <div>

                    <h3 class="card-title mb-1">
                        Create Prescription
                    </h3>

                    <div class="text-secondary">
                        Create a prescription for this medical record.
                    </div>

                </div>

            </div>


            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="MedicalRecordId"
                       type="hidden" />


                <!-- Body -->
                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- Medical Record Context -->
                    <div class="mb-4">

                        <label class="form-label">
                            Medical Record
                        </label>

                        <div class="alert alert-info mb-0">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-file-medical fs-2 me-3"></i>

                                <div>

                                    <div class="fw-bold">
                                        Medical Record #@Model.MedicalRecordId
                                    </div>

                                    <div class="text-secondary small">
                                        This prescription will be permanently associated
                                        with this medical record.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Prescription Date -->
                    <div class="mb-3">

                        <label asp-for="PrescriptionDate"
                               class="form-label">

                            Prescription Date

                        </label>

                        <input asp-for="PrescriptionDate"
                               class="form-control"
                               type="date"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="PrescriptionDate"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Notes -->
                    <div class="mb-0">

                        <label asp-for="Notes"
                               class="form-label">

                            Notes

                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Add any notes related to this prescription..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Footer -->
                <div class="card-footer d-flex justify-content-end gap-2">

                    <a asp-controller="MedicalRecord"
                       asp-action="Details"
                       asp-route-id="@Model.MedicalRecordId"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-prescription2 me-1"></i>

                        Create Prescription

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}