```cshtml
@model Clinexa.Models.Entities.Prescription

@{
    ViewData["Title"] = "Prescription Details";

    var prescriptionItems =
        ViewBag.PrescriptionItems
        as List<Clinexa.Models.Entities.PrescriptionItem>
        ?? new List<Clinexa.Models.Entities.PrescriptionItem>();
}

@section PageActions {

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>
        Back to Prescriptions
    </a>

    <a asp-action="Edit"
       asp-route-id="@Model.PrescriptionId"
       class="btn btn-primary">
        <i class="bi bi-pencil me-1"></i>
        Edit
    </a>

}

<div class="row row-cards">

    <!-- Prescription Information -->

    <div class="col-lg-8">

        <div class="card">

            <div class="card-header">

                <div>
                    <h3 class="card-title mb-1">
                        Prescription #@Model.PrescriptionId
                    </h3>

                    <div class="text-secondary">
                        Prescription information
                    </div>
                </div>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-6">

                        <div class="text-secondary mb-1">
                            Prescription ID
                        </div>

                        <div class="fw-bold">
                            #@Model.PrescriptionId
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="text-secondary mb-1">
                            Prescription Date
                        </div>

                        <div class="fw-bold">
                            @Model.PrescriptionDate.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="text-secondary mb-1">
                            Medical Record
                        </div>

                        <div>
                            <span class="badge bg-blue-lt">
                                Medical Record #@Model.MedicalRecordId
                            </span>
                        </div>

                    </div>

                    <div class="col-12">

                        <div class="text-secondary mb-1">
                            Notes
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <div>
                                @Model.Notes
                            </div>
                        }
                        else
                        {
                            <div class="text-secondary">
                                No notes were added.
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Prescription Items -->

    <div class="col-lg-4">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    Prescription Items
                </h3>

                <div class="card-actions">

                    <a asp-controller="PrescriptionItem"
                       asp-action="Create"
                       asp-route-prescriptionId="@Model.PrescriptionId"
                       class="btn btn-primary btn-sm">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Medicine

                    </a>

                </div>

            </div>


            <div class="card-body p-0">

                @if (prescriptionItems.Any())
                {
                    <div class="list-group list-group-flush">

                        @foreach (var item in prescriptionItems)
                        {
                            <div class="list-group-item">

                                <div class="d-flex align-items-start justify-content-between gap-3">

                                    <div>

                                        <div class="fw-bold">
                                            @item.Medicine.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Medicine.GenericName))
                                        {
                                            <div class="text-secondary small">
                                                @item.Medicine.GenericName
                                            </div>
                                        }
                                        <div class="text-secondary small">
                                            @item.Dosage
                                        </div>

                                    </div>

                                    <div class="btn-list flex-nowrap">

                                        <a asp-controller="PrescriptionItem"
                                           asp-action="Details"
                                           asp-route-id="@item.PrescriptionItemId"
                                           class="btn btn-icon btn-ghost-primary"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-controller="PrescriptionItem"
                                           asp-action="Edit"
                                           asp-route-id="@item.PrescriptionItemId"
                                           class="btn btn-icon btn-ghost-secondary"
                                           title="Edit">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                    </div>

                                </div>

                                <div class="mt-2">

                                    <div class="text-secondary small">
                                        <strong>Frequency:</strong>
                                        @item.Frequency
                                    </div>

                                    <div class="text-secondary small">
                                        <strong>Duration:</strong>
                                        @item.Duration
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Instructions))
                                    {
                                        <div class="text-secondary small mt-1">
                                            <strong>Instructions:</strong>
                                            @item.Instructions
                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty py-5">

                        <div class="empty-icon">
                            <i class="bi bi-capsule fs-1"></i>
                        </div>

                        <p class="empty-title">
                            No medicines added
                        </p>

                        <p class="empty-subtitle text-secondary">
                            Add medicines to complete this prescription.
                        </p>

                        <div class="empty-action">

                            <a asp-controller="PrescriptionItem"
                               asp-action="Create"
                               asp-route-prescriptionId="@Model.PrescriptionId"
                               class="btn btn-primary">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add Medicine

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>

</div>
```
