@model Clinexa.Models.Entities.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row align-items-center">

            <div class="col">
                <div class="page-pretitle">
                    Billing
                </div>

                <h2 class="page-title">
                    Payment #@Model.PaymentId
                </h2>
            </div>

            <div class="col-auto ms-auto">

                <div class="btn-list">

                    <a asp-controller="Invoice"
                       asp-action="Details"
                       asp-route-id="@Model.InvoiceId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Back to Invoice

                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@Model.PaymentId"
                       class="btn btn-primary">

                        <i class="bi bi-pencil me-1"></i>
                        Edit Payment

                    </a>

                </div>

            </div>

        </div>
    </div>
</div>


<div class="page-body">
    <div class="container-xl">

        <div class="row row-cards">

            <!-- Payment Information -->
            <div class="col-lg-8">

                <div class="card">

                    <div class="card-header">

                        <h3 class="card-title">
                            Payment Information
                        </h3>

                    </div>


                    <div class="card-body">

                        <div class="row g-4">

                            <!-- Payment ID -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Payment Number
                                </div>

                                <div class="fw-bold">
                                    #@Model.PaymentId
                                </div>

                            </div>


                            <!-- Payment Date -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Payment Date
                                </div>

                                <div class="fw-bold">
                                    @Model.PaymentDate.ToString("dd MMM yyyy")
                                </div>

                            </div>


                            <!-- Amount -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Amount
                                </div>

                                <div class="fw-bold fs-2 text-success">

                                    @Model.Amount.ToString("N2")

                                    <span class="fs-5">
                                        EGP
                                    </span>

                                </div>

                            </div>


                            <!-- Payment Method -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Payment Method
                                </div>

                                <div>

                                    <span class="badge bg-blue-lt">
                                        @Model.PaymentMethod
                                    </span>

                                </div>

                            </div>


                            <!-- Reference -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Reference Number
                                </div>

                                <div class="fw-medium">

                                    @if (!string.IsNullOrWhiteSpace(Model.ReferenceNumber))
                                    {
                                        @Model.ReferenceNumber
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            —
                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- Invoice -->
                            <div class="col-md-6">

                                <div class="text-secondary small mb-1">
                                    Invoice
                                </div>

                                <a asp-controller="Invoice"
                                   asp-action="Details"
                                   asp-route-id="@Model.InvoiceId"
                                   class="text-reset text-decoration-none">

                                    <div class="fw-bold">

                                        Invoice #@Model.InvoiceId

                                        <i class="bi bi-box-arrow-up-right ms-1 small"></i>

                                    </div>

                                </a>

                            </div>


                            <!-- Notes -->
                            <div class="col-12">

                                <div class="text-secondary small mb-1">
                                    Notes
                                </div>

                                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                                {
                                    <div>
                                        @Model.Notes
                                    </div>
                                }
                                else
                                {
                                    <div class="text-secondary">
                                        No notes
                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Payment Summary -->
            <div class="col-lg-4">

                <div class="card">

                    <div class="card-header">

                        <h3 class="card-title">
                            Payment Summary
                        </h3>

                    </div>

                    <div class="card-body">

                        <div class="mb-3">

                            <div class="text-secondary small">
                                Payment Amount
                            </div>

                            <div class="fw-bold fs-2">
                                @Model.Amount.ToString("N2")
                                <span class="fs-5">
                                    EGP
                                </span>
                            </div>

                        </div>


                        <div class="hr my-3"></div>


                        <a asp-controller="Invoice"
                           asp-action="Details"
                           asp-route-id="@Model.InvoiceId"
                           class="btn btn-outline-primary w-100">

                            <i class="bi bi-receipt me-1"></i>
                            View Invoice

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>