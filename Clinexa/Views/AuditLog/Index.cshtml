@model IEnumerable<Clinexa.Models.Entities.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}


<!-- Page Header -->
<div class="page-header d-print-none">

    <div class="row align-items-center">

        <!-- Title -->
        <div class="col">

            <div class="page-pretitle">
                Security & Monitoring
            </div>

            <h2 class="page-title">
                Audit Logs
            </h2>

        </div>


        <!-- Description -->
        <div class="col-auto">

            <div class="text-secondary">

                <i class="bi bi-shield-check me-1"></i>

                System activity history

            </div>

        </div>

    </div>

</div>


<!-- Audit Logs -->
<div class="card">

    <!-- Card Header -->
    <div class="card-header">

        <div>

            <h3 class="card-title mb-1">
                Activity Logs
            </h3>

            <div class="text-secondary small">
                Track important actions performed across Clinexa.
            </div>

        </div>

    </div>


    <!-- Table -->
    <div class="table-responsive">

        <table class="table table-vcenter card-table">

            <thead>

                <tr>

                    <th>Action</th>

                    <th>Entity</th>

                    <th>Entity ID</th>

                    <th>User</th>

                    <th>IP Address</th>

                    <th>Date</th>

                    <th class="w-1">Actions</th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var log in Model)
                    {
                        <tr>

                            <!-- Action -->
                            <td>

                                @switch (log.Action)
                                {
                                    case "Create":

                                        <span class="badge bg-green-lt">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Create
                                        </span>

                                        break;


                                    case "Update":

                                        <span class="badge bg-blue-lt">
                                            <i class="bi bi-pencil me-1"></i>
                                            Update
                                        </span>

                                        break;


                                    case "Delete":

                                        <span class="badge bg-red-lt">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </span>

                                        break;


                                    case "Activate":

                                        <span class="badge bg-green-lt">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Activate
                                        </span>

                                        break;


                                    case "Deactivate":

                                        <span class="badge bg-yellow-lt">
                                            <i class="bi bi-pause-circle me-1"></i>
                                            Deactivate
                                        </span>

                                        break;


                                    default:

                                        <span class="badge bg-secondary-lt">
                                            @log.Action
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Entity -->
                            <td>

                                <div class="fw-semibold">
                                    @log.EntityName
                                </div>

                            </td>


                            <!-- Entity ID -->
                            <td>

                                <span class="text-secondary">
                                    #@log.EntityId
                                </span>

                            </td>


                            <!-- User -->
                            <td>

                                <div class="fw-semibold">

                                    @if (log.User != null)
                                    {
                                        @log.User.FirstName
                                        @(" ")
                                        @log.User.LastName
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            User #@log.UserId
                                        </span>
                                    }

                                </div>

                            </td>


                            <!-- IP Address -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                {
                                    <span class="text-secondary">

                                        <i class="bi bi-globe2 me-1"></i>

                                        @log.IpAddress

                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- Timestamp -->
                            <td>

                                <div class="fw-semibold">
                                    @log.Timestamp.ToString("dd MMM yyyy")
                                </div>

                                <div class="text-secondary small">
                                    @log.Timestamp.ToString("hh:mm tt")
                                </div>

                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="btn-list flex-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@log.AuditLogId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7" class="text-center py-5">

                            <div class="text-secondary">

                                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>

                                <div class="fw-semibold">
                                    No audit logs found
                                </div>

                                <div class="small">
                                    There are no recorded activities yet.
                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>