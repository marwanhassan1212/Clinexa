@model Clinexa.Models.ViewModels.AuditLog.AuditLogFilterViewModel

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="card mb-3">

    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3">

                <!-- Search -->
                <div class="col-md-3">

                    <label class="form-label">
                        Search
                    </label>

                    <div class="input-icon">

                        <span class="input-icon-addon">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Entity, action, ID, IP..." />

                    </div>

                </div>

                <!-- Action -->
                <div class="col-md-2">

                    <label class="form-label">
                        Action
                    </label>

                    <select name="action" class="form-select">

                        <option value="">
                            All Actions
                        </option>

                        @foreach (var action in Model.Actions)
                        {
                            if (Model.Action == action)
                            {
                                <option value="@action" selected>
                                    @action
                                </option>
                            }
                            else
                            {
                                <option value="@action">
                                    @action
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- Entity -->
                <div class="col-md-2">

                    <label class="form-label">
                        Entity
                    </label>

                    <select name="entityName" class="form-select">

                        <option value="">
                            All Entities
                        </option>

                        @foreach (var entity in Model.EntityNames)
                        {
                            if (Model.EntityName == entity)
                            {
                                <option value="@entity" selected>
                                    @entity
                                </option>
                            }
                            else
                            {
                                <option value="@entity">
                                    @entity
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- User -->
                <div class="col-md-2">

                    <label class="form-label">
                        User
                    </label>

                    <select name="userId" class="form-select">

                        <option value="">
                            All Users
                        </option>

                        @foreach (var user in Model.Users)
                        {
                            if (Model.UserId == user.Id)
                            {
                                <option value="@user.Id" selected>
                                    @user.FirstName @user.LastName
                                </option>
                            }
                            else
                            {
                                <option value="@user.Id">
                                    @user.FirstName @user.LastName
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- Date From -->
                <div class="col-md-1">

                    <label class="form-label">
                        From
                    </label>

                    <input type="date"
                           name="dateFrom"
                           value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))"
                           class="form-control" />

                </div>

                <!-- Date To -->
                <div class="col-md-2">

                    <label class="form-label">
                        To
                    </label>

                    <input type="date"
                           name="dateTo"
                           value="@(Model.DateTo?.ToString("yyyy-MM-dd"))"
                           class="form-control" />

                </div>

            </div>

            <!-- Filter Actions -->
            <div class="mt-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-funnel me-1"></i>

                    Apply Filters

                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                    Reset

                </a>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     AUDIT LOGS TABLE
========================================================== -->

<div class="card">

    <!-- Header -->
    <div class="card-header">

        <div>

            <h3 class="card-title mb-1">
                Activity Logs
            </h3>

            <div class="text-secondary small">
                @Model.TotalCount audit logs found
            </div>

        </div>

    </div>


    <!-- Table -->
    <div class="table-responsive">

        <table class="table table-vcenter card-table">

            <thead>

                <tr>

                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>User</th>
                    <th>IP Address</th>
                    <th>Date</th>
                    <th class="w-1">Actions</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.AuditLogs.Any())
                {
                    foreach (var log in Model.AuditLogs)
                    {
                        <tr>

                            <!-- Action -->
                            <td>

                                @switch (log.Action)
                                {
                                    case "Create":

                                        <span class="badge bg-green-lt">
                                            <i class="bi bi-plus-circle me-1"></i>
                                            Create
                                        </span>

                                        break;

                                    case "Update":

                                        <span class="badge bg-blue-lt">
                                            <i class="bi bi-pencil me-1"></i>
                                            Update
                                        </span>

                                        break;

                                    case "Delete":

                                        <span class="badge bg-red-lt">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </span>

                                        break;

                                    case "Activate":

                                        <span class="badge bg-green-lt">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Activate
                                        </span>

                                        break;

                                    case "Deactivate":

                                        <span class="badge bg-yellow-lt">
                                            <i class="bi bi-pause-circle me-1"></i>
                                            Deactivate
                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-secondary-lt">
                                            @log.Action
                                        </span>

                                        break;
                                }

                            </td>


                            <!-- Entity -->
                            <td>

                                <div class="fw-semibold">
                                    @log.EntityName
                                </div>

                            </td>


                            <!-- Entity ID -->
                            <td>

                                <span class="text-secondary">
                                    #@log.EntityId
                                </span>

                            </td>


                            <!-- User -->
                            <td>

                                @if (log.User != null)
                                {
                                    <div class="fw-semibold">

                                        @log.User.FirstName
                                        @log.User.LastName

                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        User #@log.UserId
                                    </span>
                                }

                            </td>


                            <!-- IP -->
                            <td>

                                @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                {
                                    <span class="text-secondary">

                                        <i class="bi bi-globe2 me-1"></i>

                                        @log.IpAddress

                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        —
                                    </span>
                                }

                            </td>


                            <!-- Date -->
                            <td>

                                <div class="fw-semibold">
                                    @log.Timestamp.ToString("dd MMM yyyy")
                                </div>

                                <div class="text-secondary small">
                                    @log.Timestamp.ToString("hh:mm:ss tt")
                                </div>

                            </td>


                            <!-- Actions -->
                            <td>

                                <div class="btn-list flex-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@log.AuditLogId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7"
                            class="text-center py-5">

                            <div class="text-secondary">

                                <i class="bi bi-journal-x fs-1 d-block mb-2"></i>

                                <div class="fw-semibold">
                                    No audit logs found
                                </div>

                                <div class="small">
                                    Try changing your filters.
                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-center">

            <nav>

                <ul class="pagination mb-0">

                    <!-- Previous -->
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-action="@Model.Action"
                           asp-route-entityName="@Model.EntityName"
                           asp-route-userId="@Model.UserId"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>


                    <!-- Pages -->
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-search="@Model.Search"
                               asp-route-action="@Model.Action"
                               asp-route-entityName="@Model.EntityName"
                               asp-route-userId="@Model.UserId"
                               asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                               asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                               asp-route-page="@i"
                               asp-route-pageSize="@Model.PageSize">

                                @i

                            </a>

                        </li>
                    }


                    <!-- Next -->
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@Model.Search"
                           asp-route-action="@Model.Action"
                           asp-route-entityName="@Model.EntityName"
                           asp-route-userId="@Model.UserId"
                           asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>