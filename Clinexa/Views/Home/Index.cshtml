@model Clinexa.Models.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var hour = DateTime.Now.Hour;

    var greeting =
        hour < 12 ? "Good morning" :
        hour < 18 ? "Good afternoon" :
        "Good evening";
}

<!-- Page Header -->
<div class="page-header d-print-none mb-4">

    <div class="row align-items-center">

        <div class="col">

            <div class="page-pretitle">
                Clinic Overview
            </div>

            <h2 class="page-title">
                @greeting
            </h2>

            <div class="text-secondary mt-1">
                Monitor appointments, patients, doctors, and billing activity.
            </div>

        </div>

        <div class="col-auto ms-auto">

            <a asp-controller="Appointment"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-calendar-plus me-1"></i>
                New Appointment

            </a>

        </div>

    </div>

</div>


<!-- KPI Cards -->
<div class="row row-cards mb-4">

    <!-- Today's Appointments -->
    <div class="col-sm-6 col-xl-3">

        <div class="card">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="subheader">
                        Today's Appointments
                    </div>

                    <div class="ms-auto">
                        <i class="bi bi-calendar-check text-primary fs-2"></i>
                    </div>

                </div>

                <div class="h1 mb-0 mt-2">
                    @Model.TodayAppointments
                </div>

                <div class="text-secondary mt-1">
                    Scheduled for today
                </div>

            </div>

        </div>

    </div>


    <!-- Active Patients -->
    <div class="col-sm-6 col-xl-3">

        <div class="card">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="subheader">
                        Active Patients
                    </div>

                    <div class="ms-auto">
                        <i class="bi bi-people text-success fs-2"></i>
                    </div>

                </div>

                <div class="h1 mb-0 mt-2">
                    @Model.ActivePatients.ToString("N0")
                </div>

                <div class="text-secondary mt-1">
                    Currently active
                </div>

            </div>

        </div>

    </div>


    <!-- Active Doctors -->
    <div class="col-sm-6 col-xl-3">

        <div class="card">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="subheader">
                        Active Doctors
                    </div>

                    <div class="ms-auto">
                        <i class="bi bi-person-badge text-info fs-2"></i>
                    </div>

                </div>

                <div class="h1 mb-0 mt-2">
                    @Model.ActiveDoctors
                </div>

                <div class="text-secondary mt-1">
                    Currently active
                </div>

            </div>

        </div>

    </div>


    <!-- Today's Revenue -->
    <div class="col-sm-6 col-xl-3">

        <div class="card">

            <div class="card-body">

                <div class="d-flex align-items-center">

                    <div class="subheader">
                        Today's Revenue
                    </div>

                    <div class="ms-auto">
                        <i class="bi bi-cash-stack text-warning fs-2"></i>
                    </div>

                </div>

                <div class="h1 mb-0 mt-2">
                    @Model.TodayRevenue.ToString("N2") EGP
                </div>

                <div class="text-secondary mt-1">
                    Payments received today
                </div>

            </div>

        </div>

    </div>

</div>


<!-- Main Operations -->
<div class="row row-cards mb-4">

    <!-- Today's Appointments -->
    <div class="col-lg-8">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Today's Appointments
                </h3>

                <div class="card-actions">

                    <a asp-controller="Appointment"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">

                        View All

                    </a>

                </div>

            </div>


            @if (Model.TodayAppointmentsList.Any())
            {
                <div class="table-responsive">

                    <table class="table table-vcenter card-table">

                        <thead>

                            <tr>
                                <th>Time</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Status</th>
                                <th class="w-1"></th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var appointment in Model.TodayAppointmentsList)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @DateTime.Today
                                            .Add(appointment.StartTime)
                                            .ToString("hh:mm tt")
                                        </strong>
                                    </td>

                                    <td>
                                        @appointment.PatientName
                                    </td>

                                    <td>
                                        @appointment.DoctorName
                                    </td>

                                    <td>

                                        @switch (appointment.Status)
                                        {
                                            case Clinexa.Enums.AppointmentStatus.Scheduled:

                                                <span class="badge bg-secondary-lt">
                                                    Scheduled
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.Confirmed:

                                                <span class="badge bg-success-lt">
                                                    Confirmed
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.CheckedIn:

                                                <span class="badge bg-warning-lt">
                                                    Checked In
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.InConsultation:

                                                <span class="badge bg-primary-lt">
                                                    In Consultation
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.Completed:

                                                <span class="badge bg-success-lt">
                                                    Completed
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.Cancelled:

                                                <span class="badge bg-danger-lt">
                                                    Cancelled
                                                </span>

                                                break;

                                            case Clinexa.Enums.AppointmentStatus.NoShow:

                                                <span class="badge bg-warning-lt">
                                                    No Show
                                                </span>

                                                break;
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="Appointment"
                                           asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="card-body">

                    <div class="empty py-4">

                        <div class="empty-icon">
                            <i class="bi bi-calendar-x fs-2"></i>
                        </div>

                        <p class="empty-title">
                            No appointments today
                        </p>

                        <p class="empty-subtitle text-secondary">
                            There are no appointments scheduled for today.
                        </p>

                        <div class="empty-action">

                            <a asp-controller="Appointment"
                               asp-action="Create"
                               class="btn btn-primary">

                                <i class="bi bi-calendar-plus me-1"></i>
                                Book Appointment

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>


    <!-- Today's Overview -->
    <div class="col-lg-4">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Today's Overview
                </h3>

            </div>

            <div class="card-body">

                <!-- Completed -->
                <div class="d-flex align-items-center mb-4">

                    <span class="avatar avatar-sm bg-success-lt me-3">
                        <i class="bi bi-check-circle text-success"></i>
                    </span>

                    <div class="flex-fill">

                        <div class="fw-semibold">
                            Completed
                        </div>

                        <div class="text-secondary small">
                            Finished appointments
                        </div>

                    </div>

                    <div class="fw-bold fs-2">
                        @Model.CompletedAppointments
                    </div>

                </div>


                <!-- Upcoming -->
                <div class="d-flex align-items-center mb-4">

                    <span class="avatar avatar-sm bg-primary-lt me-3">
                        <i class="bi bi-clock text-primary"></i>
                    </span>

                    <div class="flex-fill">

                        <div class="fw-semibold">
                            Upcoming
                        </div>

                        <div class="text-secondary small">
                            Still waiting
                        </div>

                    </div>

                    <div class="fw-bold fs-2">
                        @Model.UpcomingAppointments
                    </div>

                </div>


                <!-- Cancelled -->
                <div class="d-flex align-items-center mb-4">

                    <span class="avatar avatar-sm bg-danger-lt me-3">
                        <i class="bi bi-x-circle text-danger"></i>
                    </span>

                    <div class="flex-fill">

                        <div class="fw-semibold">
                            Cancelled
                        </div>

                        <div class="text-secondary small">
                            Cancelled today
                        </div>

                    </div>

                    <div class="fw-bold fs-2">
                        @Model.CancelledAppointments
                    </div>

                </div>


                <!-- No Show -->
                <div class="d-flex align-items-center">

                    <span class="avatar avatar-sm bg-warning-lt me-3">
                        <i class="bi bi-person-x text-warning"></i>
                    </span>

                    <div class="flex-fill">

                        <div class="fw-semibold">
                            No Show
                        </div>

                        <div class="text-secondary small">
                            Did not attend
                        </div>

                    </div>

                    <div class="fw-bold fs-2">
                        @Model.NoShowAppointments
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Billing + Attention -->
<div class="row row-cards mb-4">

    <!-- Billing -->
    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Billing
                </h3>

                <div class="card-actions">

                    <a asp-controller="Invoice"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-secondary">

                        View Invoices

                    </a>

                </div>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-sm-6">

                        <div class="subheader">
                            Unpaid Invoices
                        </div>

                        <div class="h1 mb-1">
                            @Model.UnpaidInvoices
                        </div>

                        <div class="text-secondary">
                            Unpaid or partially paid
                        </div>

                    </div>

                    <div class="col-sm-6">

                        <div class="subheader">
                            Outstanding Amount
                        </div>

                        <div class="h1 mb-1">
                            @Model.OutstandingAmount.ToString("N2") EGP
                        </div>

                        <div class="text-secondary">
                            Remaining balance
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Needs Attention -->
    <div class="col-lg-6">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Needs Attention
                </h3>

            </div>


            @if (Model.Alerts.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var alert in Model.Alerts)
                    {
                        <a asp-controller="@alert.Controller"
                           asp-action="@alert.Action"
                           class="list-group-item list-group-item-action">

                            <div class="row align-items-center">

                                <div class="col-auto">

                                    <span class="avatar avatar-sm bg-secondary-lt">

                                        <i class="@alert.Icon @alert.CssClass"></i>

                                    </span>

                                </div>

                                <div class="col">

                                    <div class="fw-semibold">
                                        @alert.Title
                                    </div>

                                    <div class="text-secondary small">
                                        @alert.Description
                                    </div>

                                </div>

                                <div class="col-auto">

                                    <i class="bi bi-chevron-right text-secondary"></i>

                                </div>

                            </div>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="card-body">

                    <div class="empty py-3">

                        <div class="empty-icon">

                            <i class="bi bi-check-circle text-success fs-2"></i>

                        </div>

                        <p class="empty-title mb-1">
                            Everything looks good
                        </p>

                        <p class="empty-subtitle text-secondary">
                            No urgent items require attention.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</div>