@model Clinexa.Models.ViewModels.Search.SearchResultViewModel
@{
    ViewData["Title"] = "Search";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Search Results</h2>

            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <p class="text-muted mb-0">
                    Results for:
                    <strong>@Model.SearchTerm</strong>
                </p>
            }
        </div>
    </div>


    @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="card">
            <div class="card-body text-center py-5">

                <i class="bi bi-search fs-1 text-muted"></i>

                <h4 class="mt-3">
                    Search Clinexa
                </h4>

                <p class="text-muted mb-0">
                    Search for patients, doctors, or appointments.
                </p>

            </div>
        </div>
    }
    else if (
    Model.Patients.Count == 0 &&
    Model.Doctors.Count == 0 &&
    Model.Appointments.Count == 0)
    {
        <div class="card">
            <div class="card-body text-center py-5">

                <i class="bi bi-search fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No results found
                </h4>

                <p class="text-muted mb-0">
                    No patients, doctors, or appointments matched
                    "<strong>@Model.SearchTerm</strong>".
                </p>

            </div>
        </div>
    }
    else
    {
        <!-- Patients -->
        @if (Model.Patients.Any())
        {
            <div class="card mb-4">

                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-people me-2"></i>
                        Patients
                        <span class="badge bg-primary ms-2">
                            @Model.Patients.Count
                        </span>
                    </h3>
                </div>

                <div class="table-responsive">

                    <table class="table table-vcenter card-table">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Phone</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var patient in Model.Patients)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @patient.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @patient.Phone
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Patient"
                                           asp-action="Details"
                                           asp-route-id="@patient.PatientId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }


        <!-- Doctors -->
        @if (Model.Doctors.Any())
        {
            <div class="card mb-4">

                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-person-badge me-2"></i>
                        Doctors
                        <span class="badge bg-success ms-2">
                            @Model.Doctors.Count
                        </span>
                    </h3>
                </div>

                <div class="table-responsive">

                    <table class="table table-vcenter card-table">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Speciality</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var doctor in Model.Doctors)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @doctor.FullName
                                        </strong>
                                    </td>

                                    <td>
                                        @doctor.SpecialityName
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Doctor"
                                           asp-action="Details"
                                           asp-route-id="@doctor.DoctorId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }


        <!-- Appointments -->
        @if (Model.Appointments.Any())
        {
            <div class="card mb-4">

                <div class="card-header">
                    <h3 class="card-title">
                        <i class="bi bi-calendar-check me-2"></i>
                        Appointments
                        <span class="badge bg-warning ms-2">
                            @Model.Appointments.Count
                        </span>
                    </h3>
                </div>

                <div class="table-responsive">

                    <table class="table table-vcenter card-table">

                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var appointment in Model.Appointments)
                            {
                                <tr>

                                    <td>
                                        @appointment.PatientName
                                    </td>

                                    <td>
                                        @appointment.DoctorName
                                    </td>

                                    <td>
                                        @appointment.AppointmentDate.ToString("dd/MM/yyyy")
                                        <br />
                                        @appointment.StartTime.ToString(@"hh\:mm")
                                    </td>>

                                    <td>
                                        @appointment.StartTime.ToString(@"hh\:mm")
                                    </td>

                                    <td>
                                        @appointment.Status
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Appointment"
                                           asp-action="Details"
                                           asp-route-id="@appointment.AppointmentId"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye me-1"></i>
                                            View

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
    }

</div>