@using Clinexa.Enums
@model Clinexa.Models.ViewModels.Appointment.AppointmentFilterViewModel

@{
    ViewData["Title"] = "Appointments";
}

@section PageActions {
    <a asp-controller="Appointment"
       asp-action="Create"
       class="btn btn-primary px-3 py-2">
        <i class="bi bi-plus-lg me-1"></i>
        Add Appointment</a>
}


    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3">

                    <!-- Search -->
                    <div class="col-md-4">
                        <label class="form-label">Search</label>

                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="Search"
                                   value="@Model.Search"
                                   class="form-control"
                                   placeholder="Patient or doctor..." />
                        </div>
                    </div>


                    <!-- Doctor -->
                    <div class="col-md-2">
                        <label class="form-label">Doctor</label>

                        <select name="DoctorId" class="form-select">
                            <option value="">All Doctors</option>

                            @foreach (var doctor in Model.Doctors)
                            {
                                <option value="@doctor.DoctorId"
                                        selected="@(Model.DoctorId == doctor.DoctorId)">
                                    @doctor.User.FirstName @doctor.User.LastName
                                </option>
                            }
                        </select>
                    </div>


                    <!-- Patient -->
                    <div class="col-md-2">
                        <label class="form-label">Patient</label>

                        <select name="PatientId" class="form-select">
                            <option value="">All Patients</option>

                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.PatientId"
                                        selected="@(Model.PatientId == patient.PatientId)">
                                    @patient.FirstName @patient.LastName
                                </option>
                            }
                        </select>
                    </div>


                    <!-- Date -->
                    <div class="col-md-2">
                        <label class="form-label">Date</label>

                        <input type="date"
                               name="AppointmentDate"
                               value="@(Model.AppointmentDate?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>


                    <!-- Status -->
                    <div class="col-md-2">
                        <label class="form-label">Status</label>

                        <select name="Status" class="form-select">
                            <option value="">All Statuses</option>

                            @foreach (var status in Enum.GetValues<AppointmentStatus>())
                            {
                                <option value="@status"
                                        selected="@(Model.Status == status)">
                                    @status
                                </option>
                            }
                        </select>
                    </div>

                </div>


                <!-- Filter Actions -->
                <div class="mt-3 d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>
                        Apply Filters
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset
                    </a>

                </div>

            </form>

        </div>
    </div>


    <!-- Appointments Table -->
    <div class="card">

        <div class="table-responsive">

            <table class="table table-vcenter card-table">

                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Speciality</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Status</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Appointments.Any())
                    {
                        foreach (var appointment in Model.Appointments)
                        {
                            <tr>

                                <!-- Patient -->
                                <td>
                                    <div class="fw-semibold">
                                        @appointment.Patient.FirstName
                                        @appointment.Patient.LastName
                                    </div>

                                    <div class="text-secondary small">
                                        @appointment.Patient.PhoneNumber
                                    </div>
                                </td>


                                <!-- Doctor -->
                                <td>
                                    <div class="fw-semibold">
                                        Dr.
                                        @appointment.Doctor.User.FirstName
                                        @appointment.Doctor.User.LastName
                                    </div>
                                </td>


                                <!-- Speciality -->
                                <td>
                                    @appointment.Doctor.Speciality.Name
                                </td>


                                <!-- Date -->
                                <td>
                                    @appointment.AppointmentDate.ToString("dd MMM yyyy")
                                </td>


                                <!-- Time -->
                                <td>
                                    @appointment.StartTime.ToString(@"hh\:mm")
                                    -
                                    @appointment.EndTime.ToString(@"hh\:mm")
                                </td>


                                <!-- Status -->
                                <td>

                                    @switch (appointment.AppointmentStatus)
                                    {
                                        case AppointmentStatus.Scheduled:
                                            <span class="badge bg-blue-lt">
                                                Scheduled
                                            </span>
                                            break;

                                        case AppointmentStatus.Confirmed:
                                            <span class="badge bg-green-lt">
                                                Confirmed
                                            </span>
                                            break;

                                        case AppointmentStatus.CheckedIn:
                                            <span class="badge bg-yellow-lt">
                                                Checked In
                                            </span>
                                            break;

                                        case AppointmentStatus.Completed:
                                            <span class="badge bg-green-lt">
                                                Completed
                                            </span>
                                            break;

                                        case AppointmentStatus.Cancelled:
                                            <span class="badge bg-red-lt">
                                                Cancelled
                                            </span>
                                            break;

                                        default:
                                            <span class="badge bg-secondary-lt">
                                                @appointment.AppointmentStatus
                                            </span>
                                            break;
                                    }

                                </td>


                                <!-- Actions -->
                            <td>
                                <div class="btn-list flex-nowrap">

                                    <a asp-action="Details"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (appointment.AppointmentStatus != AppointmentStatus.Cancelled &&
                                                                appointment.AppointmentStatus != AppointmentStatus.Completed)
                                    {
                                        <form asp-action="Cancel"
                                              asp-route-id="@appointment.AppointmentId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Cancel"
                                                    onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                                <i class="bi bi-x-lg"></i>
                                            </button>

                                        </form>
                                    }
                                    else if (appointment.AppointmentStatus == AppointmentStatus.Cancelled)
                                    {
                                        <form asp-action="Reactivate"
                                              asp-route-id="@appointment.AppointmentId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Reactivate"
                                                    onclick="return confirm('Are you sure you want to reactivate this appointment?');">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>

                                        </form>
                                    }

                                </div>
                            </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">

                                <div class="text-secondary">

                                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>

                                    <div class="fw-semibold">
                                        No appointments found
                                    </div>

                                    <div class="small">
                                        Try changing your filters or create a new appointment.
                                    </div>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-center">

                <nav>
                    <ul class="pagination mb-0">

                        <!-- Previous -->
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Search="@Model.Search"
                               asp-route-DoctorId="@Model.DoctorId"
                               asp-route-PatientId="@Model.PatientId"
                               asp-route-AppointmentDate="@Model.AppointmentDate?.ToString("yyyy-MM-dd")"
                               asp-route-Status="@Model.Status"
                               asp-route-Page="@(Model.Page - 1)">

                                <i class="bi bi-chevron-left"></i>
                            </a>

                        </li>


                        <!-- Pages -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-Search="@Model.Search"
                                   asp-route-DoctorId="@Model.DoctorId"
                                   asp-route-PatientId="@Model.PatientId"
                                   asp-route-AppointmentDate="@Model.AppointmentDate?.ToString("yyyy-MM-dd")"
                                   asp-route-Status="@Model.Status"
                                   asp-route-Page="@i">
                                    @i
                                </a>

                            </li>
                        }


                        <!-- Next -->
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-Search="@Model.Search"
                               asp-route-DoctorId="@Model.DoctorId"
                               asp-route-PatientId="@Model.PatientId"
                               asp-route-AppointmentDate="@Model.AppointmentDate?.ToString("yyyy-MM-dd")"
                               asp-route-Status="@Model.Status"
                               asp-route-Page="@(Model.Page + 1)">

                                <i class="bi bi-chevron-right"></i>
                            </a>

                        </li>

                    </ul>
                </nav>

            </div>
        }

    </div>

</div>
```
