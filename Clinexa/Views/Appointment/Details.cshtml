@using Clinexa.Enums
@model Clinexa.Models.Entities.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="clinexa-page-header d-print-none">

        <div class="clinexa-page-title">
            <h2 class="mb-0 fw-bold">
                <i class="bi bi-calendar2-check me-2 text-primary"></i>
                Appointment Details
            </h2>
        </div>

        <div class="clinexa-page-actions">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>

            @if (Model.AppointmentStatus != AppointmentStatus.Cancelled &&
                        Model.AppointmentStatus != AppointmentStatus.Completed)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.AppointmentId"
                   class="btn btn-primary">
                    <i class="bi bi-pencil me-1"></i>
                    Edit
                </a>
            }

        </div>

    </div>


    <div class="row g-3">

        <!-- Appointment Information -->
        <div class="col-lg-8">

            <div class="card">

                <div class="card-header">
                    <h3 class="card-title">
                        Appointment Information
                    </h3>
                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- Patient -->
                        <div class="col-md-6">

                            <div class="text-secondary small mb-1">
                                Patient
                            </div>

                            <div class="fw-semibold fs-3">
                                @Model.Patient?.FirstName
                                @Model.Patient?.LastName
                            </div>

                            <div class="text-secondary">
                                @Model.Patient?.PhoneNumber
                            </div>

                        </div>


                        <!-- Doctor -->
                        <div class="col-md-6">

                            <div class="text-secondary small mb-1">
                                Doctor
                            </div>

                            <div class="fw-semibold fs-3">
                                Dr.
                                @Model.Doctor?.User?.FirstName
                                @Model.Doctor?.User?.LastName
                            </div>

                            <div class="text-secondary">
                                @Model.Doctor?.Speciality?.Name
                            </div>

                        </div>


                        <!-- Date -->
                        <div class="col-md-4">

                            <div class="text-secondary small mb-1">
                                Date
                            </div>

                            <div class="fw-semibold">
                                @Model.AppointmentDate.ToString("dd MMM yyyy")
                            </div>

                        </div>


                        <!-- Time -->
                        <div class="col-md-4">

                            <div class="text-secondary small mb-1">
                                Time
                            </div>

                            <div class="fw-semibold">
                                @Model.StartTime.ToString(@"hh\:mm")
                                -
                                @Model.EndTime.ToString(@"hh\:mm")
                            </div>

                        </div>


                        <!-- Status -->
                        <div class="col-md-4">

                            <div class="text-secondary small mb-1">
                                Status
                            </div>

                            @switch (Model.AppointmentStatus)
                            {
                                case AppointmentStatus.Scheduled:
                                    <span class="badge bg-blue-lt">
                                        Scheduled
                                    </span>
                                    break;

                                case AppointmentStatus.Confirmed:
                                    <span class="badge bg-green-lt">
                                        Confirmed
                                    </span>
                                    break;

                                case AppointmentStatus.CheckedIn:
                                    <span class="badge bg-yellow-lt">
                                        Checked In
                                    </span>
                                    break;

                                case AppointmentStatus.Completed:
                                    <span class="badge bg-green-lt">
                                        Completed
                                    </span>
                                    break;

                                case AppointmentStatus.Cancelled:
                                    <span class="badge bg-red-lt">
                                        Cancelled
                                    </span>
                                    break;

                                default:
                                    <span class="badge bg-secondary-lt">
                                        @Model.AppointmentStatus
                                    </span>
                                    break;
                            }

                        </div>


                        <!-- Reason -->
                        <div class="col-12">

                            <div class="text-secondary small mb-1">
                                Reason for Visit
                            </div>

                            <div>
                                @(string.IsNullOrWhiteSpace(Model.Reason)
                                                                ? "No reason provided."
                                                                : Model.Reason)
                            </div>

                        </div>


                        <!-- Notes -->
                        <div class="col-12">

                            <div class="text-secondary small mb-1">
                                Notes
                            </div>

                            <div class="text-wrap">
                                @(string.IsNullOrWhiteSpace(Model.Notes)
                                                                ? "No additional notes."
                                                                : Model.Notes)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quick Actions -->
        <div class="col-lg-4">

            <div class="card">

                <div class="card-header">
                    <h3 class="card-title">
                        Quick Actions
                    </h3>
                </div>

                <div class="card-body">

                    @if (Model.AppointmentStatus != AppointmentStatus.Cancelled &&
                                        Model.AppointmentStatus != AppointmentStatus.Completed)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@Model.AppointmentId"
                           class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-pencil me-1"></i>
                            Edit Appointment
                        </a>

                        <form asp-action="Cancel"
                              asp-route-id="@Model.AppointmentId"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-outline-danger w-100"
                                    onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel Appointment
                            </button>

                        </form>
                    }
                    else
                    {
                        <div class="text-secondary text-center py-3">
                            No actions are available for this appointment.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
```
