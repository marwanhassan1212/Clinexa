@model Clinexa.Models.ViewModels.InvoiceItem.InvoiceItemCreateViewModel

@{
    ViewData["Title"] = "Add Invoice Item";
}

<div class="container-fluid">

    <div class="clinexa-page-header d-print-none">

        <div class="clinexa-page-title">

            <div class="text-secondary small mb-1">
                Billing
            </div>

            <h2 class="mb-0 fw-bold">
                <i class="bi bi-receipt me-2 text-primary"></i>
                Add Invoice Item
            </h2>

        </div>

        <div class="clinexa-page-actions">

            <a asp-controller="Invoice"
               asp-action="Details"
               asp-route-id="@Model.InvoiceId"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Invoice

            </a>

        </div>

    </div>


    <div class="row justify-content-center">

        <div class="col-lg-7 col-xl-6">

            <div class="card">

                <div class="card-header">

                    <h3 class="card-title">
                        Item Information
                    </h3>

                </div>


                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="InvoiceId" type="hidden" />

                    <div class="card-body">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <input asp-for="Description"
                                   class="form-control"
                                   placeholder="e.g. Consultation, X-Ray, Medicine" />

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="Quantity"
                                       class="form-label">
                                    Quantity
                                </label>

                                <input asp-for="Quantity"
                                       type="number"
                                       min="1"
                                       class="form-control" />

                                <span asp-validation-for="Quantity"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="col-md-6 mb-3">

                                <label asp-for="UnitPrice"
                                       class="form-label">
                                    Unit Price
                                </label>

                                <div class="input-group">

                                    <input asp-for="UnitPrice"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           class="form-control" />

                                    <span class="input-group-text">
                                        EGP
                                    </span>

                                </div>

                                <span asp-validation-for="UnitPrice"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <div class="alert alert-info">

                            <div class="d-flex">

                                <i class="bi bi-info-circle me-2"></i>

                                <div>
                                    <strong>Total price</strong>
                                    will be calculated automatically
                                    from quantity × unit price.
                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="card-footer">

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Invoice"
                               asp-action="Details"
                               asp-route-id="@Model.InvoiceId"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>
                                Add Item

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}