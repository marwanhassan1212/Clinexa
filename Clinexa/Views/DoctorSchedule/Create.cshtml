@model Clinexa.Models.ViewModels.DoctorSchedule.DoctorScheduleCreateViewModel

@{
    ViewData["Title"] = "Create Doctor Schedule";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">

        <div class="col">
            <div class="page-pretitle">
                Doctor Schedules
            </div>

            <h2 class="page-title">
                <i class="bi bi-clock-history me-2"></i>
                Create Schedule
            </h2>
        </div>

        <div class="col-auto ms-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Back
            </a>
        </div>

    </div>
</div>

<div class="row row-cards">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-header">
                <h3 class="card-title">
                    Schedule Information
                </h3>
            </div>

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="DoctorId" class="form-label">
                            Doctor
                        </label>

                        <select asp-for="DoctorId"
                                class="form-select"
                                required>

                            <option value="">Select Doctor</option>

                            @foreach (var doctor in ViewBag.Doctors)
                            {
                                <option value="@doctor.DoctorId">
                                    Dr. @doctor.User.FirstName @doctor.User.LastName
                                    — @doctor.Speciality.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="DoctorId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="DayOfWeek" class="form-label">
                            Day
                        </label>

                        <select asp-for="DayOfWeek"
                                class="form-select">

                            <option value="">Select Day</option>
                            <option value="Saturday">Saturday</option>
                            <option value="Sunday">Sunday</option>
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>

                        </select>

                        <span asp-validation-for="DayOfWeek"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="StartTime"
                                   class="form-label">
                                Start Time
                            </label>

                            <input asp-for="StartTime"
                                   type="time"
                                   class="form-control" />

                            <span asp-validation-for="StartTime"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="EndTime"
                                   class="form-label">
                                End Time
                            </label>

                            <input asp-for="EndTime"
                                   type="time"
                                   class="form-control" />

                            <span asp-validation-for="EndTime"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

                <div class="card-footer d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        Create Schedule
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="card">

            <div class="card-header">
                <h3 class="card-title">
                    Scheduling Rules
                </h3>
            </div>

            <div class="card-body">

                <div class="d-flex mb-3">

                    <div class="me-3">
                        <span class="avatar bg-blue-lt">
                            <i class="bi bi-calendar-check"></i>
                        </span>
                    </div>

                    <div>
                        <strong>Doctor Availability</strong>

                        <div class="text-secondary">
                            The schedule determines when the doctor
                            can receive appointments.
                        </div>
                    </div>

                </div>

                <div class="d-flex mb-3">

                    <div class="me-3">
                        <span class="avatar bg-green-lt">
                            <i class="bi bi-clock"></i>
                        </span>
                    </div>

                    <div>
                        <strong>Valid Time</strong>

                        <div class="text-secondary">
                            End time must be later than start time.
                        </div>
                    </div>

                </div>

                <div class="d-flex">

                    <div class="me-3">
                        <span class="avatar bg-yellow-lt">
                            <i class="bi bi-exclamation-circle"></i>
                        </span>
                    </div>

                    <div>
                        <strong>Duplicate Schedule</strong>

                        <div class="text-secondary">
                            The same doctor cannot have two schedules
                            starting at the same time on the same day.
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}