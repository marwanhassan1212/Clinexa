@model Clinexa.Models.Entities.DoctorSchedule

@{
    ViewData["Title"] = "Schedule Details";
}

<div class="page-header d-print-none mb-3">

    <div class="row align-items-center">

        <div class="col">

            <div class="page-pretitle">
                Doctor Schedules
            </div>

            <h2 class="page-title">

                <i class="bi bi-clock-history me-2"></i>
                Schedule Details

            </h2>

        </div>


        <div class="col-auto ms-auto">

            <div class="btn-list">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back

                </a>


                <a asp-action="Edit"
                   asp-route-id="@Model.DoctorScheduleId"
                   class="btn btn-primary">

                    <i class="bi bi-pencil me-1"></i>
                    Edit

                </a>

            </div>

        </div>

    </div>

</div>


<div class="row row-cards">

    <div class="col-lg-8">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    Schedule Information
                </h3>

            </div>


            <div class="card-body">

                <div class="row">

                    <!-- Doctor -->

                    <div class="col-md-6 mb-4">

                        <div class="text-secondary mb-1">
                            Doctor
                        </div>

                        <a asp-controller="Doctor"
                           asp-action="Details"
                           asp-route-id="@Model.DoctorId"
                           class="fw-semibold fs-3 text-decoration-none">

                            Dr.
                            @Model.Doctor?.User?.FirstName
                            @Model.Doctor?.User?.LastName

                        </a>

                    </div>


                    <!-- Speciality -->

                    <div class="col-md-6 mb-4">

                        <div class="text-secondary mb-1">
                            Speciality
                        </div>

                        <div class="fw-semibold">

                            @Model.Doctor?.Speciality?.Name

                        </div>

                    </div>


                    <!-- Day -->

                    <div class="col-md-6 mb-4">

                        <div class="text-secondary mb-1">
                            Day
                        </div>

                        <div class="fw-semibold">

                            @Model.DayOfWeek

                        </div>

                    </div>


                    <!-- Working Hours -->

                    <div class="col-md-6 mb-4">

                        <div class="text-secondary mb-1">
                            Working Hours
                        </div>

                        <div class="fw-semibold">

                            @Model.StartTime.ToString(@"hh\:mm")
                            -
                            @Model.EndTime.ToString(@"hh\:mm")

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Status -->

    <div class="col-lg-4">

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    Status
                </h3>

            </div>


            <div class="card-body text-center">

                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success-lt text-success fs-3">

                        <i class="bi bi-check-circle me-1"></i>
                        Available

                    </span>

                    <div class="text-secondary mt-3">

                        This schedule is currently available
                        for appointments.

                    </div>
                }
                else
                {
                    <span class="badge bg-secondary-lt text-secondary fs-3">

                        <i class="bi bi-x-circle me-1"></i>
                        Unavailable

                    </span>

                    <div class="text-secondary mt-3">

                        This schedule is currently unavailable
                        for appointments.

                    </div>
                }

            </div>

        </div>

    </div>

</div>