
@model Clinexa.Models.Entities.MedicalRecord

@{
    ViewData["Title"] = "Medical Record Details";
}

@section PageActions {

    <a asp-action="Edit"
       asp-route-id="@Model.MedicalRecordId"
       class="btn btn-primary">

        <i class="bi bi-pencil me-1"></i>
        Edit Record

    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back

    </a>

}

<div class="row row-cards">

    <!-- Patient / Visit Summary -->

    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <div>

                    <h3 class="card-title mb-1">
                        Medical Record #@Model.MedicalRecordId
                    </h3>

                    <div class="text-secondary">
                        Clinical information and visit history.
                    </div>

                </div>

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <!-- Patient -->

                    <div class="col-md-4">

                        <div class="text-secondary mb-1">
                            Patient
                        </div>

                        @if (Model.Patient != null)
                        {
                            <a asp-controller="Patient"
                               asp-action="Details"
                               asp-route-id="@Model.PatientId"
                               class="text-reset text-decoration-none">

                                <div class="d-flex align-items-center">

                                    <span class="avatar avatar-sm me-2">
                                        @Model.Patient.FirstName.Substring(0, 1).ToUpper()
                                    </span>

                                    <div>

                                        <div class="fw-semibold">

                                            @Model.Patient.FirstName
                                            @Model.Patient.LastName

                                        </div>

                                        <div class="text-secondary">
                                            Patient #@Model.PatientId
                                        </div>

                                    </div>

                                </div>

                            </a>
                        }
                        else
                        {
                            <span class="text-secondary">
                                Unknown patient
                            </span>
                        }

                    </div>


                    <!-- Doctor -->

                    <div class="col-md-4">

                        <div class="text-secondary mb-1">
                            Doctor
                        </div>

                        @if (Model.Doctor?.User != null)
                        {
                            <a asp-controller="Doctor"
                               asp-action="Details"
                               asp-route-id="@Model.DoctorId"
                               class="text-reset text-decoration-none">

                                <div class="fw-semibold">

                                    Dr.
                                    @Model.Doctor.User.FirstName
                                    @Model.Doctor.User.LastName

                                </div>

                                <div class="text-secondary">
                                    Doctor #@Model.DoctorId
                                </div>

                            </a>
                        }
                        else
                        {
                            <span class="text-secondary">
                                Unknown doctor
                            </span>
                        }

                    </div>


                    <!-- Appointment -->

                    <div class="col-md-4">

                        <div class="text-secondary mb-1">
                            Appointment
                        </div>

                        <a asp-controller="Appointment"
                           asp-action="Details"
                           asp-route-id="@Model.AppointmentId"
                           class="text-decoration-none">

                            <span class="badge bg-blue-lt">
                                Appointment #@Model.AppointmentId
                            </span>

                        </a>

                        @if (Model.Appointment != null)
                        {
                            <div class="text-secondary mt-2">

                                @Model.Appointment.AppointmentDate
                                ·
                                @Model.Appointment.StartTime

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Clinical Information -->

    <div class="col-md-8">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Clinical Information
                </h3>

            </div>

            <div class="card-body">

                <div class="mb-4">

                    <div class="text-secondary mb-1">
                        Symptoms
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Symptoms))
                    {
                        <div>
                            @Model.Symptoms
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No symptoms recorded.
                        </div>
                    }

                </div>


                <div class="mb-4">

                    <div class="text-secondary mb-1">
                        Diagnosis
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Diagnosis))
                    {
                        <div>
                            @Model.Diagnosis
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No diagnosis recorded.
                        </div>
                    }

                </div>


                <div class="mb-4">

                    <div class="text-secondary mb-1">
                        Treatment
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Treatment))
                    {
                        <div>
                            @Model.Treatment
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No treatment recorded.
                        </div>
                    }

                </div>


                <div>

                    <div class="text-secondary mb-1">
                        Notes
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div>
                            @Model.Notes
                        </div>
                    }
                    else
                    {
                        <div class="text-secondary">
                            No additional notes.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Follow-up -->

    <div class="col-md-4">

        <div class="card h-100">

            <div class="card-header">

                <h3 class="card-title">
                    Follow-up
                </h3>

            </div>

            <div class="card-body">

                @if (Model.FollowUpDate.HasValue)
                {
                    <div class="text-center py-3">

                        <div class="avatar avatar-lg bg-yellow-lt mb-3">

                            <i class="bi bi-calendar-event fs-2"></i>

                        </div>

                        <div class="text-secondary">
                            Next follow-up
                        </div>

                        <div class="h3 mt-1 mb-0">

                            @Model.FollowUpDate.Value

                        </div>

                    </div>
                }
                else
                {
                    <div class="empty">

                        <div class="empty-icon">

                            <i class="bi bi-calendar-x fs-2"></i>

                        </div>

                        <p class="empty-title">
                            No follow-up scheduled
                        </p>

                        <p class="empty-subtitle text-secondary">
                            No follow-up date has been recorded for this visit.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Prescription -->

    <div class="col-12">

        <div class="card">

            <div class="card-header">

                <div>

                    <h3 class="card-title">
                        Prescription
                    </h3>

                    <div class="text-secondary">
                        Medication prescribed during this visit.
                    </div>

                </div>

                @if (Model.Prescription != null)
                {
                    <div class="card-actions">

                        <a asp-controller="Prescription"
                           asp-action="Details"
                           asp-route-id="@Model.Prescription.PrescriptionId"
                           class="btn btn-outline-primary btn-sm">

                            <i class="bi bi-eye me-1"></i>
                            View Prescription

                        </a>

                    </div>
                }

            </div>

            <div class="card-body">

                @if (Model.Prescription != null)
                {
                    <div class="d-flex align-items-center">

                        <span class="avatar avatar-sm bg-blue-lt me-3">

                            <i class="bi bi-prescription2"></i>

                        </span>

                        <div>

                            <div class="fw-semibold">

                                Prescription
                                #@Model.Prescription.PrescriptionId

                            </div>

                            <div class="text-secondary">

                                @Model.Prescription.PrescriptionDate

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="empty py-4">

                        <div class="empty-icon">

                            <i class="bi bi-prescription2 fs-2"></i>

                        </div>

                        <p class="empty-title">
                            No prescription
                        </p>

                        <p class="empty-subtitle text-secondary">
                            No prescription has been created for this medical record.
                        </p>

                        @if (Model.Appointment?.AppointmentStatus == Clinexa.Enums.AppointmentStatus.Completed)
                        {
                            <div class="empty-action">

                                <a asp-controller="Prescription"
                                   asp-action="Create"
                                   asp-route-medicalRecordId="@Model.MedicalRecordId"
                                   class="btn btn-primary">

                                    <i class="bi bi-plus-lg me-1"></i>
                                    Create Prescription

                                </a>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- Record Metadata -->

    <div class="col-12">

        <div class="card">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <div class="text-secondary">
                            Created
                        </div>

                        <div class="fw-semibold">
                            @Model.CreatedAt
                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="text-secondary">
                            Last Updated
                        </div>

                        <div class="fw-semibold">

                            @if (Model.UpdatedAt.HasValue)
                            {
                                @Model.UpdatedAt.Value
                            }
                            else
                            {
                                <span class="text-secondary">
                                    Never updated
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
