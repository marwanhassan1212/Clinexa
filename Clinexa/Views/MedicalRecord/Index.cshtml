@model List<Clinexa.Models.Entities.MedicalRecord>

@{
    ViewData["Title"] = "Medical Records";
}

@section PageActions {

    <a asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-lg me-1"></i>
        New Medical Record

    </a>

}

<div class="card">

    <div class="card-header">

        <div>

            <h3 class="card-title mb-1">
                Medical Records
            </h3>

            <div class="text-secondary">
                Manage patient clinical records and medical history.
            </div>

        </div>

    </div>

    <div class="card-body border-bottom">

        <div class="row g-2">

            <div class="col-md-6">

                <div class="input-icon">

                    <span class="input-icon-addon">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           id="medicalRecordSearch"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Search by patient, doctor, appointment, or record ID..." />

                </div>

            </div>

            <div class="col-md-3">

                <select id="doctorFilter"
                        class="form-select">

                    <option value="">
                        All Doctors
                    </option>

                    @foreach (var doctor in Model
                                        .Where(x => x.Doctor?.User != null)
                                        .Select(x => new
                                        {
                                            Id = x.DoctorId,
                                            Name = $"Dr. {x.Doctor.User.FirstName} {x.Doctor.User.LastName}"
                                        })
                                        .DistinctBy(x => x.Id)
                                        .OrderBy(x => x.Name))
                    {
                        <option value="@doctor.Id">
                            @doctor.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-3">

                <select id="sortRecords"
                        class="form-select">

                    <option value="newest">
                        Newest first
                    </option>

                    <option value="oldest">
                        Oldest first
                    </option>

                </select>

            </div>

        </div>

    </div>

    <div class="table-responsive">

        <table class="table table-vcenter card-table"
               id="medicalRecordsTable">

            <thead>

                <tr>

                    <th>
                        ID
                    </th>

                    <th>
                        Patient
                    </th>

                    <th>
                        Doctor
                    </th>

                    <th>
                        Appointment
                    </th>

                    <th>
                        Created
                    </th>

                    <th>
                        Follow-up
                    </th>

                    <th class="w-1">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var record in Model)
                    {
                        var patientName =
                        record.Patient != null
                        ? $"{record.Patient.FirstName} {record.Patient.LastName}"
                        : "Unknown patient";

                        var doctorName =
                        record.Doctor?.User != null
                        ? $"Dr. {record.Doctor.User.FirstName} {record.Doctor.User.LastName}"
                        : "Unknown doctor";

                        <tr class="medical-record-row"
                            data-doctor="@record.DoctorId"
                            data-search="@($"{record.MedicalRecordId} {record.PatientId} {patientName} {doctorName} {record.AppointmentId}")">

                            <td>

                                <span class="fw-bold">
                                    #@record.MedicalRecordId
                                </span>

                            </td>

                            <td>

                                @if (record.Patient != null)
                                {
                                    <a asp-controller="Patient"
                                       asp-action="Details"
                                       asp-route-id="@record.PatientId"
                                       class="text-reset text-decoration-none">

                                        <div class="fw-semibold">
                                            @record.Patient.FirstName
                                            @record.Patient.LastName
                                        </div>

                                        <div class="text-secondary small">
                                            Patient #@record.PatientId
                                        </div>

                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        Unknown patient
                                    </span>
                                }

                            </td>

                            <td>

                                @if (record.Doctor?.User != null)
                                {
                                    <a asp-controller="Doctor"
                                       asp-action="Details"
                                       asp-route-id="@record.DoctorId"
                                       class="text-reset text-decoration-none">

                                        <div class="fw-semibold">
                                            Dr.
                                            @record.Doctor.User.FirstName
                                            @record.Doctor.User.LastName
                                        </div>

                                        <div class="text-secondary small">
                                            Doctor #@record.DoctorId
                                        </div>

                                    </a>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        Unknown doctor
                                    </span>
                                }

                            </td>

                            <td>

                                @if (record.Appointment != null)
                                {
                                    <div class="fw-semibold">
                                        #@record.AppointmentId
                                    </div>

                                    <div class="text-secondary small">
                                        @record.Appointment.AppointmentDate.ToString("dd MMM yyyy")
                                        ·
                                        @record.Appointment.StartTime.ToString(@"hh\:mm")
                                    </div>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        —
                                    </span>
                                }

                            </td>

                            <td>

                                <span class="text-secondary">
                                    @record.CreatedAt.ToString("dd MMM yyyy")
                                </span>

                            </td>

                            <td>

                                @if (record.FollowUpDate.HasValue)
                                {
                                    <span class="badge bg-yellow-lt">

                                        @record.FollowUpDate.Value.ToString("dd MMM yyyy")

                                    </span>
                                }
                                else
                                {
                                    <span class="text-secondary">
                                        No follow-up
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="btn-list flex-nowrap"
                                     style="margin-left: 20px;">

                                    <a asp-controller="MedicalRecord"
                                       asp-action="Details"
                                       asp-route-id="@record.MedicalRecordId"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-controller="MedicalRecord"
                                       asp-action="Edit"
                                       asp-route-id="@record.MedicalRecordId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7">

                            <div class="empty py-5">

                                <div class="empty-icon">

                                    <i class="bi bi-file-medical fs-1"></i>

                                </div>

                                <p class="empty-title">
                                    No medical records found
                                </p>

                                <p class="empty-subtitle text-secondary">
                                    Medical records are created from completed or eligible appointments.
                                </p>

                                <div class="empty-action">

                                    <a asp-action="Create"
                                       class="btn btn-primary">

                                        <i class="bi bi-plus-lg me-1"></i>
                                        Create Medical Record

                                    </a>

                                </div>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("medicalRecordSearch");

            const doctorFilter =
                document.getElementById("doctorFilter");

            const sortRecords =
                document.getElementById("sortRecords");

            const table =
                document.getElementById("medicalRecordsTable");

            if (!table) {
                return;
            }

            const tbody =
                table.querySelector("tbody");

            function getRows() {

                return Array.from(
                    tbody.querySelectorAll(".medical-record-row")
                );

            }

            function filterRecords() {

                const search =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const doctor =
                    doctorFilter.value;

                getRows().forEach(row => {

                    const rowSearch =
                        (row.dataset.search || "")
                            .toLowerCase();

                    const rowDoctor =
                        row.dataset.doctor || "";

                    const matchesSearch =
                        !search ||
                        rowSearch.includes(search);

                    const matchesDoctor =
                        !doctor ||
                        rowDoctor === doctor;

                    row.style.display =
                        matchesSearch && matchesDoctor
                            ? ""
                            : "none";

                });

            }

            function sortRecordsTable() {

                const rows = getRows();

                rows.sort(function (a, b) {

                    const idA =
                        parseInt(
                            a.querySelector("td:first-child")
                                .innerText
                                .replace("#", "")
                                .trim()
                        );

                    const idB =
                        parseInt(
                            b.querySelector("td:first-child")
                                .innerText
                                .replace("#", "")
                                .trim()
                        );

                    return sortRecords.value === "newest"
                        ? idB - idA
                        : idA - idB;

                });

                rows.forEach(row => {
                    tbody.appendChild(row);
                });

                filterRecords();

            }

            searchInput.addEventListener(
                "input",
                filterRecords
            );

            doctorFilter.addEventListener(
                "change",
                filterRecords
            );

            sortRecords.addEventListener(
                "change",
                sortRecordsTable
            );

            sortRecordsTable();

        });

    </script>

}