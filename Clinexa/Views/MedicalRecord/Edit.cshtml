@model Clinexa.Models.ViewModels.MedicalRecord.MedicalRecordEditViewModel

@{
    ViewData["Title"] = "Edit Medical Record";
}

@section PageActions {

    <a asp-action="Details"
       asp-route-id="@Model.MedicalRecordId"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left me-1"></i>
        Back to Record

    </a>

}

<form asp-action="Edit"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="MedicalRecordId" type="hidden" />

    <div class="row row-cards">

        <!-- ========================= -->
        <!-- Record Information -->
        <!-- ========================= -->

        <div class="col-12">

            <div class="card">

                <div class="card-header">

                    <div>

                        <h3 class="card-title mb-1">
                            Edit Medical Record
                        </h3>

                        <div class="text-secondary">
                            Update the clinical information for this visit.
                        </div>

                    </div>

                    <div class="card-actions">

                        <span class="badge bg-blue-lt">
                            Record #@Model.MedicalRecordId
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- Clinical Information -->
        <!-- ========================= -->

        <div class="col-md-8">

            <div class="card h-100">

                <div class="card-header">

                    <h3 class="card-title">
                        Clinical Information
                    </h3>

                </div>

                <div class="card-body">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="mb-3">

                        <label asp-for="Symptoms"
                               class="form-label">
                            Symptoms
                        </label>

                        <textarea asp-for="Symptoms"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the patient's symptoms...">
                        </textarea>

                        <span asp-validation-for="Symptoms"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Diagnosis"
                               class="form-label">
                            Diagnosis
                        </label>

                        <textarea asp-for="Diagnosis"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter the diagnosis...">
                        </textarea>

                        <span asp-validation-for="Diagnosis"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="mb-3">

                        <label asp-for="Treatment"
                               class="form-label">
                            Treatment
                        </label>

                        <textarea asp-for="Treatment"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe the treatment plan...">
                        </textarea>

                        <span asp-validation-for="Treatment"
                              class="text-danger">
                        </span>

                    </div>


                    <div>

                        <label asp-for="Notes"
                               class="form-label">
                            Notes
                        </label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Add additional clinical notes...">
                        </textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- Follow-up -->
        <!-- ========================= -->

        <div class="col-md-4">

            <div class="card h-100">

                <div class="card-header">

                    <h3 class="card-title">
                        Follow-up
                    </h3>

                </div>

                <div class="card-body">

                    <label asp-for="FollowUpDate"
                           class="form-label">

                        Follow-up Date

                    </label>

                    <input asp-for="FollowUpDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="FollowUpDate"
                          class="text-danger">
                    </span>

                    <div class="text-secondary small mt-2">

                        Update the next planned follow-up date.

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- Actions -->
        <!-- ========================= -->

        <div class="col-12">

            <div class="card">

                <div class="card-body d-flex justify-content-end gap-2">

                    <a asp-action="Details"
                       asp-route-id="@Model.MedicalRecordId"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Save Changes

                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}