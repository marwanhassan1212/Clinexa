@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Clinexa</title>


    <!-- =========================
         Tabler
    ========================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/css/tabler.min.css" />


    <!-- =========================
         Bootstrap Icons
    ========================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =========================
         Toastr
    ========================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />


    <!-- =========================
         Clinexa
    ========================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/clinexa.css"
          asp-append-version="true" />

</head>


<body>


    <div class="page">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="navbar navbar-vertical navbar-expand-lg"
               data-bs-theme="dark">

            <div class="container-fluid">


                <!-- Brand -->

                <h1 class="navbar-brand navbar-brand-autodark">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="clinexa-brand-link">

                        <span class="clinexa-brand-icon bg-primary text-white rounded">
                            <i class="bi bi-heart-pulse"></i>
                        </span>

                        <span class="text-white fw-bold">
                            Clinexa
                        </span>

                    </a>

                </h1>


                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#sidebar-menu"
                        aria-controls="sidebar-menu"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Sidebar -->

                <div class="collapse navbar-collapse"
                     id="sidebar-menu">


                    <ul class="navbar-nav pt-lg-3">


                        <!-- Dashboard -->

                        <li class="nav-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-grid-1x2"></i>
                                </span>

                                <span class="nav-link-title">
                                    Dashboard
                                </span>

                            </a>

                        </li>


                        <!-- Patients -->

                        <li class="nav-item @(currentController == "Patient" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Patient"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-people"></i>
                                </span>

                                <span class="nav-link-title">
                                    Patients
                                </span>

                            </a>

                        </li>


                        <!-- Doctors -->

                        <li class="nav-item @(currentController == "Doctor" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Doctor"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-person-badge"></i>
                                </span>

                                <span class="nav-link-title">
                                    Doctors
                                </span>

                            </a>

                        </li>


                        <li class="nav-item @(currentController == "Appointment" ? "active" : "")">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Appointment"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-calendar3"></i>
                                </span>

                                <span class="nav-link-title">
                                    Appointments
                                </span>

                            </a>

                        </li>


                        <!-- Divider -->

                        <li class="nav-item my-3">
                            <div class="hr-text">Clinical</div>
                        </li>


                        <!-- Medical Records -->

                        <li class="nav-item @(currentController == "MedicalRecord" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="MedicalRecord"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-file-medical"></i>
                                </span>

                                <span class="nav-link-title">
                                    Medical Records
                                </span>

                            </a>

                        </li>


                        <!-- Prescriptions -->

                        <li class="nav-item @(currentController == "Prescription" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Prescription"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-prescription2"></i>
                                </span>

                                <span class="nav-link-title">
                                    Prescriptions
                                </span>

                            </a>

                        </li>


                        <!-- Medicines -->

                        <li class="nav-item @(currentController == "Medicine" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Medicine"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-capsule"></i>
                                </span>

                                <span class="nav-link-title">
                                    Medicines
                                </span>

                            </a>

                        </li>


                        <!-- Divider -->

                        <li class="nav-item my-3">
                            <div class="hr-text">Billing</div>
                        </li>


                        <!-- Invoices -->

                        <li class="nav-item @(currentController == "Invoice" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Invoice"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-receipt"></i>
                                </span>

                                <span class="nav-link-title">
                                    Invoices
                                </span>

                            </a>

                        </li>


                        <!-- Payments -->

                        <li class="nav-item @(currentController == "Payment" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Payment"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-credit-card"></i>
                                </span>

                                <span class="nav-link-title">
                                    Payments
                                </span>

                            </a>

                        </li>


                        <!-- Divider -->

                        <li class="nav-item my-3">
                            <div class="hr-text">Administration</div>
                        </li>


                        <!-- Users -->

                        <li class="nav-item @(currentController == "User" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="User"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-person-gear"></i>
                                </span>

                                <span class="nav-link-title">
                                    Users
                                </span>

                            </a>

                        </li>


                        <!-- Roles -->

                        <li class="nav-item @(currentController == "Role" ? "active" : "")">

                            <a class="nav-link"
                               asp-controller="Role"
                               asp-action="Index">

                                <span class="nav-link-icon">
                                    <i class="bi bi-shield-lock"></i>
                                </span>

                                <span class="nav-link-title">
                                    Roles
                                </span>

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </aside>


        <!-- =====================================================
             MAIN PAGE
        ====================================================== -->

        <div class="page-wrapper">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <header class="navbar navbar-expand-md d-print-none">

                <div class="container-xl">


                    <!-- Mobile Menu -->

                    <button class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbar-menu">

                        <span class="navbar-toggler-icon"></span>

                    </button>


                    <!-- Search -->

                    <div class="navbar-nav flex-row order-md-last">


                        <!-- Notifications -->

                        <div class="nav-item dropdown">

                            <a href="#"
                               class="nav-link px-0"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-bell fs-2 clinexa-notification-icon"></i>

                            </a>

                            <div class="dropdown-menu dropdown-menu-end">

                                <h6 class="dropdown-header">
                                    Notifications
                                </h6>

                                <a class="dropdown-item"
                                   href="#">
                                    New appointment booked
                                </a>

                                <a class="dropdown-item"
                                   href="#">
                                    Payment received
                                </a>

                                <a class="dropdown-item"
                                   href="#">
                                    Prescription updated
                                </a>

                            </div>

                        </div>


                        <!-- User -->

                        <div class="nav-item dropdown">

                            <a href="#"
                               class="nav-link d-flex lh-1 text-reset p-0 ms-3"
                               data-bs-toggle="dropdown">

                                <span class="avatar avatar-sm bg-blue-lt">
                                    MH
                                </span>

                                <div class="d-none d-xl-block ps-2">

                                    <div>
                                        Marwan Hassan
                                    </div>

                                    <div class="mt-1 small text-secondary">
                                        Administrator
                                    </div>

                                </div>

                            </a>


                            <div class="dropdown-menu dropdown-menu-end">

                                <a class="dropdown-item"
                                   href="#">

                                    <i class="bi bi-person me-2"></i>

                                    My Profile

                                </a>

                                <a class="dropdown-item"
                                   href="#">

                                    <i class="bi bi-gear me-2"></i>

                                    Settings

                                </a>

                                <div class="dropdown-divider"></div>

                                <a class="dropdown-item text-danger"
                                   href="#">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Logout

                                </a>

                            </div>

                        </div>

                    </div>


                    <!-- Global Search -->

                    <div class="collapse navbar-collapse"
                         id="navbar-menu">

                        <div>

                            <form>

                                <div class="input-icon">

                                    <span class="input-icon-addon">

                                        <i class="bi bi-search"></i>

                                    </span>

                                    <input type="text"
                                           class="form-control"
                                           placeholder="Search patients, doctors, appointments..." />

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </header>



            <!-- =================================================
                 PAGE CONTENT
            ================================================== -->

            <div class="page-body">

                <div class="container-xl">


                    <!-- Page Header -->

                    <div class="clinexa-page-header d-print-none">

                        <div class="clinexa-page-title">

                            <h2 class="mb-0">
                                @ViewData["Title"]
                            </h2>

                        </div>

                        <div class="clinexa-page-actions">

                            @RenderSection(
                            "PageActions",   required: false )
                        </div>

                    </div>
                    <!-- Actual View -->
                    @RenderBody()


                </div>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <footer class="footer footer-transparent d-print-none">

                <div class="container-xl">

                    <div class="row text-center align-items-center">

                        <div class="col-12">

                            © 2026 Clinexa — Clinic Management System

                        </div>

                    </div>

                </div>

            </footer>


        </div>

    </div>



    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@latest/dist/js/tabler.min.js">
    </script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js">
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
        )

</body>

</html>